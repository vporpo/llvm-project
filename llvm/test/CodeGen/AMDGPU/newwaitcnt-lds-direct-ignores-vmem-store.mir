# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# S_WAITCNT_lds_direct waits for outstanding VMEM-to-LDS loads. Pre-GFX10 has no
# separate store counter, so VMEM stores also sit on VmCnt - but a plain VMEM
# store is not a VMEM-to-LDS load and must not trigger the lds_direct wait. With
# only a buffer store pending (no LDS-DMA load), no s_waitcnt vmcnt may be
# emitted at the lds_direct point. The old pass emits none.

---
name: lds_direct_ignores_vmem_store
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
body: |
  ; CHECK-LABEL: name: lds_direct_ignores_vmem_store
  ; CHECK: BUFFER_STORE_DWORD_OFFSET
  ; CHECK-NOT: S_WAITCNT
  ; CHECK: DS_WRXCHG_RTN_B32
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, $vgpr0, $vgpr1, $vgpr5

    BUFFER_STORE_DWORD_OFFSET killed $vgpr5, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 0, 0, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    S_WAITCNT_lds_direct
    renamable $vgpr0 = DS_WRXCHG_RTN_B32_gfx9 killed renamable $vgpr0, killed renamable $vgpr1, 0, 0, implicit $exec :: (load store seq_cst (s32) on `ptr addrspace(3) poison`, addrspace 3)
    S_ENDPGM 0
...
