# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Test XCnt behavior on gfx1250:
# - XCnt waits are only needed for WAW (DEF) dependencies, not RAW (USE) dependencies.
# - RAW dependencies on address registers are covered by other counters (KmCnt).

---
name: smem_to_vmem_no_xcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr0
    ; SMEM load increments KmCnt and XCnt. The VMEM load uses the result as an
    ; address (RAW dependency). Since this is a USE dependency, no XCnt wait is
    ; needed - only KmCnt wait is required to ensure the data is available.
    ; CHECK-LABEL: name: smem_to_vmem_no_xcnt
    ; CHECK: S_LOAD_DWORDX2_IMM
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: S_WAIT_KMCNT 0
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: GLOBAL_LOAD_DWORD_SADDR
    $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
    $vgpr1 = GLOBAL_LOAD_DWORD_SADDR $sgpr2_sgpr3, $vgpr0, 0, 0, implicit $exec
    S_ENDPGM 0
...

---
name: smem_to_smem_no_xcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; SMEM load followed by another SMEM using the result as an address.
    ; This is a RAW dependency, so no XCnt wait is needed.
    ; CHECK-LABEL: name: smem_to_smem_no_xcnt
    ; CHECK: S_LOAD_DWORDX2_IMM
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: S_WAIT_KMCNT 0
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: S_LOAD_DWORD_IMM
    $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
    $sgpr4 = S_LOAD_DWORD_IMM $sgpr2_sgpr3, 0, 0
    S_ENDPGM 0
...

---
name: smem_to_salu_no_xcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; SMEM load followed by SALU using the result.
    ; This is a RAW dependency, so no XCnt wait is needed.
    ; CHECK-LABEL: name: smem_to_salu_no_xcnt
    ; CHECK: S_LOAD_DWORDX2_IMM
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: S_WAIT_KMCNT 0
    ; CHECK-NOT: S_WAIT{{.*}}XCNT
    ; CHECK: S_ADD_U32
    $sgpr2_sgpr3 = S_LOAD_DWORDX2_IMM $sgpr0_sgpr1, 0, 0
    $sgpr4 = S_ADD_U32 $sgpr2, 1, implicit-def $scc
    S_ENDPGM 0
...
