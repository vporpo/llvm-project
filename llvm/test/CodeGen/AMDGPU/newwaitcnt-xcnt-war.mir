# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s -check-prefix=GFX12
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s -check-prefix=GFX12
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s -check-prefix=GFX1250-OLD
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s -check-prefix=GFX1250-NEW

# Test WAR (Write After Read) dependency for XCnt.
# When an SMEM load is in flight, its address registers are being read for
# address translation. Overwriting those registers requires XCnt=0.
# XCnt is gfx1250+ only; gfx1200 has no XCnt counter.

# GFX12-LABEL: name: smem_war_overwrite_addr
# GFX12: S_LOAD_DWORD_IMM
# GFX12-NEXT: $sgpr0 = S_MOV_B32 0

# GFX1250-OLD-LABEL: name: smem_war_overwrite_addr
# GFX1250-OLD: S_LOAD_DWORD_IMM
# GFX1250-OLD-NEXT: S_WAIT_XCNT 0
# GFX1250-OLD-NEXT: $sgpr0 = S_MOV_B32 0

# GFX1250-NEW-LABEL: name: smem_war_overwrite_addr
# GFX1250-NEW: S_LOAD_DWORD_IMM
# GFX1250-NEW-NEXT: S_WAIT_XCNT 0
# GFX1250-NEW-NEXT: $sgpr0 = S_MOV_B32 0

---
name: smem_war_overwrite_addr
body: |
  bb.0:
    ; SMEM load reads $sgpr0_sgpr1 as address
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    ; Overwrite address register - WAR hazard, needs XCnt=0
    $sgpr0 = S_MOV_B32 0
...

# A *_SADDR load defines a result VGPR and reads the same VGPR as its vector
# address. A later read of the result is a read-after-write on the load, so it
# needs s_wait_loadcnt 0 - NOT s_wait_xcnt 0. The result-defining role must win
# over the address-reading role for the same register, on every generation.

# GFX12-LABEL: name: saddr_load_def_use_raw
# GFX12: GLOBAL_LOAD_DWORD_SADDR
# GFX12-NEXT: S_WAIT_LOADCNT 0
# GFX12-NEXT: $vgpr0 = V_MAX_I32_e32

# GFX1250-OLD-LABEL: name: saddr_load_def_use_raw
# GFX1250-OLD: GLOBAL_LOAD_DWORD_SADDR
# GFX1250-OLD-NEXT: S_WAIT_LOADCNT 0
# GFX1250-OLD-NEXT: $vgpr0 = V_MAX_I32_e32

# GFX1250-NEW-LABEL: name: saddr_load_def_use_raw
# GFX1250-NEW: GLOBAL_LOAD_DWORD_SADDR
# GFX1250-NEW-NEXT: S_WAIT_LOADCNT 0
# GFX1250-NEW-NEXT: $vgpr0 = V_MAX_I32_e32

---
name: saddr_load_def_use_raw
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1
    ; Load defines $vgpr0 and also reads $vgpr0 as its address.
    renamable $vgpr0 = GLOBAL_LOAD_DWORD_SADDR killed renamable $sgpr0_sgpr1, killed renamable $vgpr0, 0, 0, implicit $exec
    ; Read the loaded result - RAW on the load, needs loadcnt 0 (not xcnt 0).
    renamable $vgpr0 = V_MAX_I32_e32 1, killed $vgpr0, implicit $exec
    S_ENDPGM 0
...

# A VMEM load reads its address registers for translation (tracked by XCnt on
# gfx1250). An interleaved SMEM load that overwrites one of those address
# registers is a WAR hazard needing s_wait_xcnt 0, even though the SMEM/VMEM
# interleave also triggers an implicit XCnt sync. gfx1200 has no XCnt counter, so
# no wait is needed there.

# GFX12-LABEL: name: vmem_addr_war_across_interleave
# GFX12: GLOBAL_LOAD_DWORD_SADDR
# GFX12-NEXT: S_LOAD_DWORDX4_IMM

# GFX1250-OLD-LABEL: name: vmem_addr_war_across_interleave
# GFX1250-OLD: GLOBAL_LOAD_DWORD_SADDR
# GFX1250-OLD-NEXT: S_WAIT_XCNT 0
# GFX1250-OLD-NEXT: S_LOAD_DWORDX4_IMM

# GFX1250-NEW-LABEL: name: vmem_addr_war_across_interleave
# GFX1250-NEW: GLOBAL_LOAD_DWORD_SADDR
# GFX1250-NEW-NEXT: S_WAIT_XCNT 0
# GFX1250-NEW-NEXT: S_LOAD_DWORDX4_IMM

---
name: vmem_addr_war_across_interleave
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr4_sgpr5
    ; VMEM load reads $sgpr0_sgpr1 as its scalar address.
    renamable $vgpr0 = GLOBAL_LOAD_DWORD_SADDR killed renamable $sgpr0_sgpr1, killed renamable $vgpr0, 0, 0, implicit $exec
    ; Interleaved SMEM load overwrites $sgpr0_sgpr1 - WAR on the VMEM address.
    renamable $sgpr0_sgpr1_sgpr2_sgpr3 = S_LOAD_DWORDX4_IMM killed renamable $sgpr4_sgpr5, 36, 0
    S_ENDPGM 0
...
