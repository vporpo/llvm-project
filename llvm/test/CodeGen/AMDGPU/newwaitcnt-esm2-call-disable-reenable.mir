# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# In expert scheduling mode 2, the pass must disable expert mode before a call
# (s_setreg WAVE_SCHED_MODE = 0) and re-enable after the call returns
# (s_setreg WAVE_SCHED_MODE = 2). The callee runs with its own scheduling mode
# and the ABI requires disabling before transfer of control.

# CHECK-LABEL: name: esm2_call
# CHECK:        S_SETREG_IMM32_B32 2
# CHECK:        S_SETREG_IMM32_B32 0
# CHECK-NEXT:   dead $sgpr30_sgpr31 = SI_CALL
# CHECK-NEXT:   S_SETREG_IMM32_B32 2
# CHECK:        S_ENDPGM 0

---
name: esm2_call
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5, $vgpr0
    dead $sgpr30_sgpr31 = SI_CALL killed renamable $sgpr4_sgpr5, 0, csr_amdgpu, implicit killed $vgpr0
    S_ENDPGM 0
...
