# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# $vgpr45 is loaded in bb.1 (along with 2 newer loads). The other predecessor
# of bb.2 is bb.0, which branches directly without loading $vgpr45. At the CFG
# join at bb.2, a min-merge of the two predecessor states must not drop $vgpr45's
# pending dependency: $vgpr45 is still in-flight and S_WAITCNT .Vmcnt_2 must be
# emitted before the V_LSHLREV_B32 that reads it.
#
# CHECK-LABEL: name: test
# CHECK: S_WAITCNT .Vmcnt_2
# CHECK-NEXT: $vgpr8 = V_LSHLREV_B32_e32
---
name: test
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 200, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.2(0x80000000)
    $vgpr45 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 176, 0, 0, implicit $exec
    $vgpr44 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 180, 0, 0, implicit $exec
    $vgpr43 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 184, 0, 0, implicit $exec

  bb.2:
    $vgpr8 = V_LSHLREV_B32_e32 16, killed $vgpr45, implicit $exec
    S_ENDPGM 0
...
