  ; NO-DATAFLOW-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2

    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3

    ; StoreCnt (VMEM store)
    GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    ; DsCnt (LDS store)
    DS_WRITE_B32_gfx9 $vgpr6, $vgpr1, 0, 0, implicit $m0, implicit $exec

  bb.3:
    ; FLAT load - no wait needed for memory dependencies since hardware
    ; guarantees proper ordering within a wavefront.
    $vgpr4 = FLAT_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from `ptr addrspace(0) undef`)
    S_ENDPGM 0
...
