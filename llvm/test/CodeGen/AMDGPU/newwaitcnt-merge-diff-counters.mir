  ; NO-DATAFLOW: bb.0:
  ; NO-DATAFLOW-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.1:
  ; NO-DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   S_BRANCH %bb.3
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.2:
  ; NO-DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr1, 0, 0, implicit $exec
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.3:
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2

    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3

    ; LoadCnt - register dependency on vgpr0
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    ; StoreCnt - memory dependency
    GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr1, 0, 0, implicit $exec

  bb.3:
    ; Load from possibly aliasing address (memory dep from bb.2, StoreCnt)
    ; and use vgpr0 (register dep from bb.1, LoadCnt).
    ; Expect S_WAIT_LOADCNT 0 and S_WAIT_STORECNT 0.
    GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
    S_ENDPGM 0
...

# Memory-to-memory dependencies (store followed by load) do not require
# explicit waits - the hardware guarantees proper ordering within a wavefront.
# This test verifies no waits are inserted for memory-only dependencies.

---
name: no_wait_for_mem_dependencies
body: |
  ; DATAFLOW-LABEL: name: no_wait_for_mem_dependencies
  ; DATAFLOW: bb.0:
  ; DATAFLOW-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
