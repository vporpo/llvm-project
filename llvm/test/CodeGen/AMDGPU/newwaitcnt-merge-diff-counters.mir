# Check that we merge both register dependency (LoadCnt from bb.1)
# and memory dependency (StoreCnt from bb.2).

---
name: merge_reg_and_mem_dependencies
body: |
  ; DATAFLOW-LABEL: name: merge_reg_and_mem_dependencies
  ; DATAFLOW: bb.0:
  ; DATAFLOW-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; DATAFLOW-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT: bb.1:
  ; DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT:   $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
  ; DATAFLOW-NEXT:   S_BRANCH %bb.3
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT: bb.2:
  ; DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT:   GLOBAL_STORE_DWORD $vgpr2_vgpr3, $vgpr1, 0, 0, implicit $exec
