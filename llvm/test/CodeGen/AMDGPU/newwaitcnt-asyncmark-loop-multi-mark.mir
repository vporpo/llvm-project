# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
#
# In a loop, the same async load instruction is marked each iteration.
# WAIT_ASYNCMARK(1) in the loop should wait for the 2nd most recent mark —
# the load from the previous iteration. With 1 in-flight load at the point
# of the wait (from the previous iteration), asynccnt(1) is correct.
#
# CHECK-LABEL: name: loop_multi_mark
# CHECK: bb.1:
# CHECK: WAIT_ASYNCMARK 1
# CHECK-NEXT: S_WAIT_ASYNCCNT 1
---
name:            loop_multi_mark
tracksRegLiveness: false
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    S_WAIT_LOADCNT_DSCNT 0
    S_WAIT_KMCNT 0

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    WAIT_ASYNCMARK 1
    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ASYNCMARK
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
