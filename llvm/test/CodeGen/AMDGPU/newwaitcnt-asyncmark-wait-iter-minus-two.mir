# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s

# Asyncmarks waits have different semantics than normal waits because the same
# instruction can be marked across multiple iterations, yet we can wait
# on any iteration, not necessarily the one when the instruction shows up last.

---
name: wait_with_wrong_value
body:             |
  ; CHECK-LABEL: name: wait_with_wrong_value
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; CHECK-NEXT:   S_WAIT_KMCNT 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   WAIT_ASYNCMARK 1
  ; CHECK-NEXT:   S_WAIT_ASYNCCNT 1, implicit-def $asynccnt, implicit $asynccnt
  ; CHECK-NEXT:   GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
  ; CHECK-NEXT:   ASYNCMARK
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_SETPC_B64_return undef $sgpr30_sgpr31
  bb.0:

  bb.2:
    WAIT_ASYNCMARK 1

    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ASYNCMARK
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.3:
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
