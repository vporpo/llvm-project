# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Test that S_WAIT_XCNT is not emitted after waiting for data counters.
# Hardware invariant: XCnt <= data counter (address translation completes before data).
# So waiting for LoadCnt/KmCnt=0 also satisfies XCnt for the same instruction.
# These are entry functions: there is no incoming caller store that could keep
# XCnt out-of-order, so the loadcnt/kmcnt wait alone clears the WAR hazard.

#############################################################################
# LoadCnt (VMEM load)
#############################################################################

# CHECK-LABEL: name: xcnt_after_loadcnt
# CHECK: GLOBAL_LOAD_DWORD
# CHECK-NEXT: S_WAIT_LOADCNT 0
# CHECK-NEXT: V_ADD_U32
# CHECK-NOT: S_WAIT_XCNT
# CHECK-NEXT: V_MOV_B32

---
name: xcnt_after_loadcnt
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    ; Load writes $vgpr0, uses $vgpr2_vgpr3 as address
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    ; RAW on $vgpr0 - requires S_WAIT_LOADCNT 0
    $vgpr4 = V_ADD_U32_e32 $vgpr0, $vgpr0, implicit $exec
    ; WAR on $vgpr2 (address register) - but LoadCnt=0 already satisfied XCnt
    $vgpr2 = V_MOV_B32_e32 0, implicit $exec
...

#############################################################################
# KmCnt (SMEM load)
#############################################################################

# CHECK-LABEL: name: xcnt_after_kmcnt
# CHECK: S_LOAD_DWORD_IMM
# CHECK-NEXT: S_WAIT_KMCNT 0
# CHECK-NEXT: S_ADD_U32
# CHECK-NEXT: S_MOV_B32

---
name: xcnt_after_kmcnt
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    ; Load writes $sgpr0, uses $sgpr2_sgpr3 as address
    $sgpr0 = S_LOAD_DWORD_IMM $sgpr2_sgpr3, 0, 0
    ; RAW on $sgpr0 - requires S_WAIT_KMCNT 0
    $sgpr4 = S_ADD_U32 $sgpr0, $sgpr0, implicit-def $scc
    ; WAR on $sgpr2 (address register) - but KmCnt=0 already satisfied XCnt
    $sgpr2 = S_MOV_B32 0
...
