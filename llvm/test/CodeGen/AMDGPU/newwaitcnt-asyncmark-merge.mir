# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s

---
name: merge
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2, $asynccnt, $exec, $vcc
    S_CBRANCH_VCCZ %bb.1, implicit $vcc
    S_BRANCH %bb.2

  bb.1:
    liveins: $vgpr0_vgpr1, $vgpr2, $asynccnt, $exec
    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ASYNCMARK
    S_BRANCH %bb.3

  bb.2:
    liveins: $vgpr0_vgpr1, $vgpr2, $asynccnt, $exec
    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ASYNCMARK
    S_BRANCH %bb.3

  bb.3:
    ; CHECK-LABEL: bb.3
    ; CHECK:      WAIT_ASYNCMARK 0
    ; CHECK-NEXT: S_WAIT_ASYNCCNT 0
    WAIT_ASYNCMARK 0
    S_ENDPGM 0
...
