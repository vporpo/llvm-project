# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -mattr=+precise-memory -run-pass=si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX9 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -mattr=+precise-memory -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX9 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -mattr=+precise-memory -run-pass=si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX12 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -mattr=+precise-memory -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX12 %s

# Precise memory mode forces a zero-waitcnt after every memory operation.
# The waits should only cover counters the instruction actually uses, not all
# counters.

# GFX9-LABEL: name: precise_load_store
# GFX9:        GLOBAL_LOAD_DWORD
# GFX9-NEXT:   S_WAITCNT {{.*}}Vmcnt_0
# GFX9:        GLOBAL_STORE_DWORD
# GFX9-NEXT:   S_WAITCNT {{.*}}Vmcnt_0
# GFX9:        S_LOAD_DWORD_IMM
# GFX9-NEXT:   S_WAITCNT {{.*}}Lgkmcnt_0

# GFX12-LABEL: name: precise_load_store
# GFX12:        GLOBAL_LOAD_DWORD
# GFX12-NEXT:   S_WAIT_LOADCNT 0
# GFX12:        GLOBAL_STORE_DWORD
# GFX12-NEXT:   S_WAIT_STORECNT 0
# GFX12:        S_LOAD_DWORD_IMM
# GFX12-NEXT:   S_WAIT_KMCNT 0

---
name: precise_load_store
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr0_vgpr1
    renamable $vgpr2 = GLOBAL_LOAD_DWORD renamable $vgpr0_vgpr1, 0, 0, implicit $exec :: (load (s32), addrspace 1)
    GLOBAL_STORE_DWORD renamable $vgpr0_vgpr1, killed renamable $vgpr2, 0, 0, implicit $exec :: (store (s32), addrspace 1)
    renamable $sgpr2 = S_LOAD_DWORD_IMM renamable $sgpr0_sgpr1, 0, 0 :: (load (s32), addrspace 4)
    S_ENDPGM 0, implicit $sgpr2
...

# Precise memory in a loop: the wait after the last memory op in the loop
# should prevent redundant waits at the loop header.

# GFX9-LABEL: name: precise_loop
# GFX9:      bb.1:
# GFX9-NOT:  S_WAITCNT
# GFX9:      GLOBAL_LOAD_DWORD

---
name: precise_loop
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $sgpr0_sgpr1, $vgpr0_vgpr1, $sgpr2
    renamable $vgpr2 = GLOBAL_LOAD_DWORD renamable $vgpr0_vgpr1, 0, 0, implicit $exec :: (load (s32), addrspace 1)
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $sgpr0_sgpr1, $sgpr2, $vgpr0_vgpr1, $vgpr2
    renamable $vgpr2 = GLOBAL_LOAD_DWORD renamable $vgpr0_vgpr1, 0, 0, implicit $exec :: (load (s32), addrspace 1)
    $sgpr2 = S_ADD_I32 $sgpr2, -1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
