# RUN: llc -mtriple=amdgcn -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On pre-gfx10 targets, VMEM/FLAT stores increment ExpCnt (vmemWriteNeedsExpWaitcnt).
# A spill in the preheader leaves vgpr0 pending on ExpCnt. The loop body has a VMEM
# store which re-increments ExpCnt every iteration. Therefore the expCnt wait for the
# VGPR reload must remain INSIDE the loop header, not be hoisted to the preheader.
# If hoisted, iterations after the first would not have the wait and the reload could
# race with the VMEM store's register-read tracking.

# CHECK-LABEL: name: loop_expcnt_vmem_store
# CHECK:       bb.0:
# CHECK:         BUFFER_STORE_DWORD_OFFSET $vgpr0
# CHECK-NOT:     S_WAITCNT
# CHECK:         S_BRANCH %bb.1
# CHECK:       bb.1:
# CHECK:          $sgpr8_sgpr9 = S_OR_SAVEEXEC_B64
# CHECK-NEXT:     S_WAITCNT .Expcnt_0
# CHECK-NEXT:     renamable $vgpr0 = BUFFER_LOAD_DWORD_OFFSET

---
name: loop_expcnt_vmem_store
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
frameInfo:
  maxAlignment: 4
stack:
  - { id: 0, size: 4, alignment: 4 }
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4, $vgpr0

    ; Preheader: spill vgpr0 to stack. On pre-gfx10 this puts vgpr0 on ExpCnt.
    $sgpr8_sgpr9 = S_OR_SAVEEXEC_B64 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    BUFFER_STORE_DWORD_OFFSET $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: ("amdgpu-thread-private" store (s32) into %stack.0, addrspace 5)
    $exec = S_MOV_B64 killed $sgpr8_sgpr9
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4

    ; Loop header: restore exec and reload vgpr0 from stack (expCnt wait needed here).
    $sgpr8_sgpr9 = S_OR_SAVEEXEC_B64 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    renamable $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: ("amdgpu-thread-private" load (s32) from %stack.0, addrspace 5)
    $exec = S_MOV_B64 killed $sgpr8_sgpr9
    ; VMEM store: re-increments ExpCnt every iteration, invalidating a preheader hoist.
    BUFFER_STORE_DWORD_OFFSET killed renamable $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (volatile store (s32), addrspace 1)
    $sgpr4 = S_ADD_I32 $sgpr4, -1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3
    S_ENDPGM 0
...
