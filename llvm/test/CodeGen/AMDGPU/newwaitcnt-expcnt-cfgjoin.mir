#
# Two predecessor paths reach bb.2: bb.0 (direct) with 1 BUFFER_STORE holding
# $vgpr4 on ExpCnt, and bb.1 with 2 additional BUFFER_STOREs. At bb.2,
# V_MOV_B32 writes $vgpr4 — a WAR hazard with the store that holds it.
#
---
name: test
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr4, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr5, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr6, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 8, 0, 0, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_WAITCNT .Expcnt_0
  ; CHECK-NEXT:   $vgpr4 = V_MOV_B32_e32 1, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  ; OLD-LABEL: name: test
  ; OLD: bb.0:
  ; OLD-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; OLD-NEXT: {{  $}}
  ; OLD-NEXT:   S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
  ; OLD-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr4, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
  ; OLD-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; OLD-NEXT: {{  $}}
  ; OLD-NEXT: bb.1:
  ; OLD-NEXT:   successors: %bb.2(0x80000000)
  ; OLD-NEXT: {{  $}}
  ; OLD-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr5, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
  ; OLD-NEXT:   BUFFER_STORE_DWORD_ADDR64 $vgpr6, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 8, 0, 0, implicit $exec
  ; OLD-NEXT: {{  $}}
  ; OLD-NEXT: bb.2:
  ; OLD-NEXT:   S_WAITCNT .Expcnt_0
  ; OLD-NEXT:   $vgpr4 = V_MOV_B32_e32 1, implicit $exec
  ; OLD-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    BUFFER_STORE_DWORD_ADDR64 $vgpr4, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.2(0x80000000)
    BUFFER_STORE_DWORD_ADDR64 $vgpr5, $vgpr1_vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
