# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# SMEM load followed by VMEM store to the same memory location: the SMEM load
# must complete (lgkmcnt(0)) before the VMEM store overwrites the data (WAR).

# CHECK-LABEL: name: smem_vmem_war
# CHECK:      S_LOAD_DWORD_IMM
# CHECK-NEXT: S_WAITCNT
# CHECK-NEXT: GLOBAL_STORE_DWORD_SADDR

--- |
  define amdgpu_kernel void @smem_vmem_war(ptr addrspace(1) %ptr) {
    %val = load i32, ptr addrspace(1) %ptr
    store i32 0, ptr addrspace(1) %ptr
    ret void
  }
...
---
name: smem_vmem_war
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
body: |
  bb.0:
    liveins: $sgpr4_sgpr5, $vgpr0, $vgpr2, $sgpr6_sgpr7
    $sgpr4 = S_LOAD_DWORD_IMM renamable $sgpr6_sgpr7, 0, 0 :: ("amdgpu-noclobber" load (s32) from %ir.ptr, addrspace 1)
    GLOBAL_STORE_DWORD_SADDR renamable $vgpr2, renamable $vgpr2, killed renamable $sgpr6_sgpr7, 0, 0, implicit $exec :: (store (s32) into %ir.ptr, addrspace 1)
    S_ENDPGM 0
...
