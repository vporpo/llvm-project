# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s

#
# One marked load followed by one unmarked load. WAIT_ASYNCMARK(0) waits for
# the most recent mark = Load 0. Since Load 1 (unmarked) is also in-flight
# above Load 0 in VmCnt, the correct wait is vmcnt(1), not vmcnt(0).
# The bug: querying AsyncMarkPseudoCnt for the wait value gives 0 (distance
# in mark-space) instead of 1 (distance in VmCnt-space).
#
# CHECK-LABEL: name: asyncmark_unmarked_load_above
# CHECK: BUFFER_LOAD_DWORD_LDS_OFFEN
# CHECK-NEXT: ASYNCMARK
# CHECK-NEXT: BUFFER_LOAD_DWORD_LDS_OFFEN
# CHECK-NEXT: WAIT_ASYNCMARK 0
# CHECK-NEXT: S_WAITCNT .Vmcnt_1
---
name: asyncmark_unmarked_load_above
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3
    ; Load 0: marked
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, 1, implicit $exec, implicit $m0
    ASYNCMARK implicit $exec
    ; Load 1: unmarked - still in-flight above Load 0 in VmCnt
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, 1, implicit $exec, implicit $m0
    ; WAIT_ASYNCMARK(0) = wait for most recent mark = Load 0.
    ; vmcnt(1) needed because Load 1 is also in-flight above Load 0.
    WAIT_ASYNCMARK 0, implicit $exec
    S_ENDPGM 0
...
