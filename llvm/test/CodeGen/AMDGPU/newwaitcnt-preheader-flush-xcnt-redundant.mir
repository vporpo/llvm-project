# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=machine-loops,si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=machine-loops,amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Preheader flush should not emit S_WAIT_XCNT when S_WAIT_KMCNT 0 is present.
# XCnt tracks address translation; KmCnt tracks SMEM completion.
# Address translation completes before SMEM, so KmCnt=0 implies XCnt=0.

# CHECK-LABEL: name: preheader_xcnt_redundant
# CHECK: bb.0:
# CHECK: S_WAIT_KMCNT 0
# CHECK-NOT: S_WAIT_XCNT
# CHECK: S_BRANCH %bb.1

---
name: preheader_xcnt_redundant
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $sgpr0_sgpr1
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    S_BRANCH %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $sgpr2
    S_CMP_EQ_U32 $sgpr2, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
  bb.2:
    S_ENDPGM 0
...
