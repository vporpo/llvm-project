# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# This test exposes a bug in dataflow iteration where the exit state is cleared
# before merging from back-edges. In a loop with DS loads at the end (prefetch
# pattern), the back-edge should carry pending DS state to the next iteration.
#
# Without the fix, the loop body sees no pending DS reads on iteration 2+ because
# the exit state was cleared before merging from the back-edge.

---
name: backedge_ds_state
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: backedge_ds_state
  ; CHECK: bb.0:
  ; CHECK: S_BRANCH %bb.1
  ;
  ; CHECK: bb.1:
  ; On iteration 2+, we enter via back-edge with pending DS reads.
  ; We must wait for DS reads to complete before using vgpr10.
  ; CHECK: S_WAIT_DSCNT
  ; CHECK: V_ADD_F32_e32 $vgpr10
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $vgpr0, $vgpr10

    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $vgpr0, $vgpr10

    ; Use vgpr10 - needs wait if there's a pending DS read from back-edge
    $vgpr20 = V_ADD_F32_e32 $vgpr10, $vgpr10, implicit $mode, implicit $exec

    ; Prefetch: DS load for next iteration
    $vgpr10 = DS_READ_B32 $vgpr0, 0, 0, implicit $m0, implicit $exec

    ; Loop control
    $sgpr0 = S_ADD_I32 $sgpr0, -1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    liveins: $vgpr20
    S_ENDPGM 0
...
