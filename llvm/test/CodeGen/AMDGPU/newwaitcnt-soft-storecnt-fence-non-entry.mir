# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# The memory legalizer inserts a soft S_WAIT_STORECNT 0 before a seq_cst atomic
# to order it after any prior store. In a non-entry function the prior store may
# belong to the CALLER, whose StoreCnt state is unknown on entry. So this fence
# must be kept even though no store is visible in this function: the counter is
# conservatively assumed to have outstanding caller stores. (In an entry function
# there is no caller, so the wait would be removed - this test is non-entry, i.e.
# no isEntryFunction in machineFunctionInfo.)

---
name: ds_atomic_storecnt_fence
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: ds_atomic_storecnt_fence
    ; CHECK: S_WAIT_STORECNT 0
    ; CHECK-NEXT: renamable $vgpr0 = DS_ADD_RTN_U32_gfx9
    S_WAIT_STORECNT_soft 0
    renamable $vgpr0 = DS_ADD_RTN_U32_gfx9 killed renamable $vgpr0, killed renamable $vgpr1, 0, 0, implicit $exec :: (load store seq_cst (s32), addrspace 3)
    S_ENDPGM 0
...
