# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# A GISel tuple reload emits the first BUFFER_LOAD with an implicit-def of the
# whole vgpr tuple (a liveness artifact) in addition to its real explicit result
# ($vgpr0). A following instruction that writes another sub-register of that
# tuple ($vgpr2) is not a real WAW hazard against the load - the load only
# really produces $vgpr0 - so no vmcnt wait may be inserted before it. The old
# pass inserts none.

---
name: load_implicit_def_tuple_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 16, alignment: 4 }
body: |
  ; CHECK-LABEL: name: load_implicit_def_tuple_reload
  ; CHECK: $vgpr0 = BUFFER_LOAD_DWORD_OFFSET
  ; CHECK-NOT: S_WAITCNT
  ; CHECK: $vgpr2 = V_ACCVGPR_READ_B32_e64
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, $agpr0

    $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 0, 0, 0, implicit $exec, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3 :: (load (s32) from %stack.0, addrspace 5)
    $vgpr1 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 4, 0, 0, implicit $exec :: (load (s32) from %stack.0 + 4, addrspace 5)
    $vgpr2 = V_ACCVGPR_READ_B32_e64 $agpr0, implicit $exec
    S_ENDPGM 0
...
