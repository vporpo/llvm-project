  ; DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; DATAFLOW-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
