  ; DATAFLOW-NEXT:   $vgpr1 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 4, 0, implicit $exec
  ; DATAFLOW-NEXT:   $vgpr10 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 8, 0, implicit $exec
  ; DATAFLOW-NEXT:   S_BRANCH %bb.3
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT: bb.2:
  ; DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT:   $vgpr0 = GLOBAL_LOAD_DWORD $vgpr6_vgpr7, 0, 0, implicit $exec
  ; DATAFLOW-NEXT:   $vgpr11 = GLOBAL_LOAD_DWORD $vgpr6_vgpr7, 4, 0, implicit $exec
  ; DATAFLOW-NEXT: {{  $}}
  ; DATAFLOW-NEXT: bb.3:
  ; DATAFLOW-NEXT:   S_WAIT_LOADCNT 1
  ; DATAFLOW-NEXT:   GLOBAL_STORE_DWORD $vgpr4_vgpr5, $vgpr0, 0, 0, implicit $exec
  ; DATAFLOW-NEXT:   S_ENDPGM 0
  ;
  ; NO-DATAFLOW-LABEL: name: hammock_conservative_wait
  ; NO-DATAFLOW: bb.0:
  ; NO-DATAFLOW-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.1:
  ; NO-DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   $vgpr1 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 4, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   $vgpr10 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 8, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   S_BRANCH %bb.3
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.2:
  ; NO-DATAFLOW-NEXT:   successors: %bb.3(0x80000000)
  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   $vgpr0 = GLOBAL_LOAD_DWORD $vgpr6_vgpr7, 0, 0, implicit $exec
