# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -amdgpu-new-insert-waitcnts-dataflow=true %s -o - | FileCheck %s --check-prefix=DATAFLOW
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -amdgpu-new-insert-waitcnts-dataflow=false %s -o - | FileCheck %s --check-prefix=NO-DATAFLOW

# Check that we use the most conservative wait across predecessor blocks.
# bb.1 has vgpr0 as oldest load (wait 2), bb.2 has vgpr0 as oldest (wait 1).
# After merging, we should use the more conservative wait from bb.1.

---
name: hammock_conservative_wait
body: |
  ; DATAFLOW-LABEL: name: hammock_conservative_wait
  ; DATAFLOW: bb.0:
  ; DATAFLOW-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
