  ; NO-DATAFLOW-NEXT: {{  $}}
  ; NO-DATAFLOW-NEXT: bb.3:
  ; NO-DATAFLOW-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NO-DATAFLOW-NEXT:   S_WAIT_EXPCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_SAMPLECNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_BVHCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_KMCNT 0
  ; NO-DATAFLOW-NEXT:   S_WAIT_STORECNT 0
  ; NO-DATAFLOW-NEXT:   GLOBAL_STORE_DWORD $vgpr4_vgpr5, $vgpr0, 0, 0, implicit $exec
  ; NO-DATAFLOW-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2

    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3

    ; LoadCnt: 3 pending, vgpr0 is oldest (wait 2)
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    $vgpr1 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 4, 0, implicit $exec
    $vgpr10 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 8, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    ; LoadCnt: 2 pending, vgpr0 is oldest (wait 1)
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr6_vgpr7, 0, 0, implicit $exec
    $vgpr11 = GLOBAL_LOAD_DWORD $vgpr6_vgpr7, 4, 0, implicit $exec

  bb.3:
    ; Expected: wait 1 (the more conservative of wait 2 and wait 1)
    GLOBAL_STORE_DWORD $vgpr4_vgpr5, $vgpr0, 0, 0, implicit $exec
    S_ENDPGM 0
...
