# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Test that soft waits inserted by the memory legalizer for seq_cst atomic
# fence semantics are correctly promoted and not removed.
#
# The memory legalizer inserts:
# - S_WAIT_LOADCNT_soft/S_WAIT_STORECNT_soft BEFORE GLOBAL_WB (release fence)
# - S_WAIT_LOADCNT_soft/S_WAIT_STORECNT_soft/S_WAIT_DSCNT_soft/S_WAIT_XCNT_soft
#   AFTER GLOBAL_WB (acquire fence)
#
# These waits enforce memory ordering and must be preserved even when there
# are no pending LoadCnt/StoreCnt operations (only KmCnt from SMEM loads).
#
# BUG: The new pass removes the soft waits before GLOBAL_WB because it only
# checks if there are pending operations, not whether the waits are for
# fence semantics.

# CHECK-LABEL: name: seq_cst_atomic_fence
# CHECK:      dead $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM
# CHECK-NEXT: S_WAIT_KMCNT 0
# CHECK-NEXT: $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM
# CHECK:      GLOBAL_WB
# Waits after GLOBAL_WB - order may vary
# CHECK-DAG:  S_WAIT_STORECNT 0
# CHECK-DAG:  S_WAIT_KMCNT 0
# CHECK:      GLOBAL_ATOMIC_ADD_SADDR

---
name: seq_cst_atomic_fence
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5

    ; SMEM loads - increment KmCnt (but NOT LoadCnt or StoreCnt)
    dead $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM $sgpr4_sgpr5, 0, 32
    $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM killed $sgpr4_sgpr5, 0, 32
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    $vgpr1 = V_MOV_B32_e32 1, implicit $exec

    ; Fence sequence for seq_cst atomic (from memory legalizer)
    ; Release fence: wait for pending loads/stores before writeback
    S_WAIT_LOADCNT_soft 0
    S_WAIT_STORECNT_soft 0
    GLOBAL_WB 24, implicit $exec

    ; Acquire fence: wait for writeback and all memory ops before atomic
    S_WAIT_LOADCNT_soft 0
    S_WAIT_STORECNT_soft 0
    S_WAIT_DSCNT_soft 0
    S_WAIT_XCNT_soft 0
    GLOBAL_ATOMIC_ADD_SADDR killed $vgpr0, killed $vgpr1, killed $sgpr0_sgpr1, 0, 24, implicit $exec

    ; Post-atomic fence
    S_WAIT_STORECNT_soft 0
    GLOBAL_INV 24, implicit $exec
    S_WAIT_LOADCNT_soft 0
    S_ENDPGM 0
...
