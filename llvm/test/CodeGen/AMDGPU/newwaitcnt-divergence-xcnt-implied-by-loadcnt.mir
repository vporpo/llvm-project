# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s
# XFAIL: *

# Test that S_WAIT_XCNT is not emitted after waiting for LoadCnt=0.
# Hardware invariant: XCnt <= LoadCnt (address translation completes before data).
# So waiting for LoadCnt=0 also satisfies XCnt for the same instruction.
#
# The old pass emits redundant S_WAIT_XCNT; the new pass optimizes this away.

# CHECK-LABEL: name: xcnt_after_loadcnt
# CHECK: GLOBAL_LOAD_DWORD
# CHECK-NEXT: S_WAIT_LOADCNT 0
# CHECK-NEXT: V_ADD_U32
# CHECK-NEXT: V_MOV_B32

---
name: xcnt_after_loadcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr3
    ; Load writes $vgpr0, uses $vgpr2_vgpr3 as address
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    ; RAW on $vgpr0 - requires S_WAIT_LOADCNT 0
    $vgpr4 = V_ADD_U32_e32 $vgpr0, $vgpr0, implicit $exec
    ; WAR on $vgpr2 (address register) - but LoadCnt=0 already satisfied XCnt
    $vgpr2 = V_MOV_B32_e32 0, implicit $exec
...
