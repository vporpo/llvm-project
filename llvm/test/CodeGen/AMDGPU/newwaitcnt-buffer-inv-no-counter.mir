# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# BUFFER_INV is a cache invalidate: it produces no result a consumer waits for,
# so it must not be tracked on any counter (like the other BUFFER_*_INV / WBINVL1
# cache ops). Otherwise a later return would emit a spurious s_waitcnt vmcnt(0)
# for it. Here nothing should be waited on before the return.

---
name: buffer_inv_no_counter
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: buffer_inv_no_counter
    ; CHECK: BUFFER_INV 16, implicit $exec
    ; CHECK-NEXT: S_SETPC_B64_return undef $sgpr30_sgpr31
    BUFFER_INV 16, implicit $exec
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
