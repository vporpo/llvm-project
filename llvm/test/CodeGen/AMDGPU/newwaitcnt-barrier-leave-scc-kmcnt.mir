# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On GFX12+, some barrier instructions (S_BARRIER_LEAVE,
# S_BARRIER_SIGNAL_ISFIRST_*) write SCC asynchronously: the SCC result lands via
# the KmCnt counter rather than immediately. So an instruction that reads SCC
# after such a barrier must first wait for KmCnt to reach 0, otherwise it could
# read a stale SCC before the barrier's write has landed.
#
# Here S_BARRIER_LEAVE writes $scc and the following S_CSELECT_B32 reads $scc, so
# an "s_wait_kmcnt 0" is required between them.

---
name: barrier_leave_scc_read
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0
    ; CHECK-LABEL: name: barrier_leave_scc_read
    ; CHECK: S_BARRIER_LEAVE implicit-def $scc
    ; CHECK-NEXT: S_WAIT_KMCNT 0
    ; CHECK-NEXT: $sgpr1 = S_CSELECT_B32 1, 2, implicit $scc
    S_BARRIER_LEAVE implicit-def $scc
    $sgpr1 = S_CSELECT_B32 1, 2, implicit $scc
    S_ENDPGM 0
...
