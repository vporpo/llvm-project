# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On SI/CI (hasReadVCCZBug(), i.e. generation <= SEA_ISLANDS, e.g. verde) an
# in-flight SMEM load can corrupt the vccz bit. When an instruction reads vccz
# (here S_CBRANCH_VCCNZ) while an SMEM load is still outstanding, the compiler
# must work around the bug by:
#   1. inserting an "s_waitcnt lgkmcnt(0)" so the SMEM load completes, and
#   2. recomputing vccz by writing vcc back to itself ("s_mov_b64 vcc, vcc"),
#      since any write to vcc refreshes vccz.
#
# Here S_LOAD_DWORDX4_IMM (SMEM) is followed by S_CBRANCH_VCCNZ, so both the
# forced lgkmcnt(0) wait and the vcc recompute must appear before the branch.

---
name: vccz_smem_branch
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: vccz_smem_branch
  ; CHECK: $sgpr0_sgpr1_sgpr2_sgpr3 = S_LOAD_DWORDX4_IMM $sgpr4_sgpr5, 9, 0
  ; CHECK-NEXT: $vcc = S_ANDN2_B64 $exec, $sgpr6_sgpr7, implicit-def $scc
  ; CHECK-NEXT: S_WAITCNT {{.*}}Lgkmcnt_0
  ; CHECK-NEXT: $vcc = S_MOV_B64 $vcc
  ; CHECK-NEXT: S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  bb.0:
    liveins: $sgpr4_sgpr5, $sgpr6_sgpr7
    $sgpr0_sgpr1_sgpr2_sgpr3 = S_LOAD_DWORDX4_IMM $sgpr4_sgpr5, 9, 0
    $vcc = S_ANDN2_B64 $exec, $sgpr6_sgpr7, implicit-def $scc
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3
    S_NOP 0
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0
...
