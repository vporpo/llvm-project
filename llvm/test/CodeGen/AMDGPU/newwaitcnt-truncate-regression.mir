    $vgpr12 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 28, 0, 0, implicit $exec
    $vgpr13 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 24, 0, 0, implicit $exec
    $vgpr14 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 20, 0, 0, implicit $exec
    $vgpr15 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 16, 0, 0, implicit $exec
    $vgpr16 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 12, 0, 0, implicit $exec
