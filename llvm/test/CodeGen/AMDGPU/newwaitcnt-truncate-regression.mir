    $vgpr6 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 52, 0, 0, implicit $exec
    $vgpr7 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 48, 0, 0, implicit $exec
    $vgpr8 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 44, 0, 0, implicit $exec
