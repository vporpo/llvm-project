  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_WAITCNT .Vmcnt_16
  ; CHECK-NEXT:   $vgpr19 = V_PERM_B32_e64 $vgpr1, $vgpr0, 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    $vgpr0 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 76, 0, 0, implicit $exec
    $vgpr1 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 72, 0, 0, implicit $exec
