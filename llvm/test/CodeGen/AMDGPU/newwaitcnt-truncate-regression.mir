# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# 18 BUFFER_LOADs in bb.0 followed by a pre-existing S_WAITCNT .Vmcnt_17. When
# the pass processes bb.1, the two oldest loads ($vgpr0 and $vgpr1) must still
# be tracked as pending. The V_PERM_B32 in bb.1 reads $vgpr0 (oldest, vmcnt(16))
# and $vgpr1 (second oldest, already covered by vmcnt(17)), so S_WAITCNT .Vmcnt_16
# must be emitted before it.
#
---
name: test
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
  ; CHECK-NEXT:   $vgpr0 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 76, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr1 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 72, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr2 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 68, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr3 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 64, 0, 0, implicit $exec
