  ; CHECK-NEXT:   $vgpr5 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 56, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr6 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 52, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr7 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 48, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr8 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 44, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr9 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 40, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr10 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 36, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr11 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 32, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr12 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 28, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr13 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 24, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr14 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 20, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr15 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 16, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr16 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 12, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr17 = BUFFER_LOAD_USHORT_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 8, 0, 0, implicit $exec
