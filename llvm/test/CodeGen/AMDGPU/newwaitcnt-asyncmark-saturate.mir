# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# When AsyncMarkPseudoCnt is full (MaxAsyncMarks=16), WAIT_ASYNCMARK(N) with
# N >= 16 saturates to the oldest available mark.
# Here: 16 marks tracked, WAIT_ASYNCMARK(17) should use vmcnt(oldest).
# The pre-existing S_WAITCNT .Vmcnt_17 (placed by a prior pass) should be
# replaced with the correct saturated value.
#
# CHECK-LABEL: name: asyncmark_saturate
# CHECK: WAIT_ASYNCMARK 17
# CHECK-NEXT: S_WAITCNT .Vmcnt_15
---
name: asyncmark_saturate
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    WAIT_ASYNCMARK 17, implicit $exec
    S_WAITCNT .Vmcnt_17
    S_ENDPGM 0
...
