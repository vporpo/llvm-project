# RUN: llc -mtriple=amdgcn--amdpal -mcpu=bonaire -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn--amdpal -mcpu=bonaire -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Two VMEM loads on VmCnt followed by two DS writes consuming their results. The
# first DS write depends on the first load (vmcnt(1)), the second on the second
# load (vmcnt(0)). Position-based vmcnt waits are valid here because the loads
# complete in order on VmCnt (same VmemType, no FLAT). The consumer being a DS
# instruction (on LgkmCnt) is irrelevant to the VmCnt ordering of the sources.

# CHECK-LABEL: name: vmcnt_ds_consumer
# CHECK:        BUFFER_LOAD_DWORD_ADDR64
# CHECK:        BUFFER_LOAD_DWORD_ADDR64
# CHECK:        S_WAITCNT .Vmcnt_1
# CHECK-NEXT:   DS_WRITE_B32
# CHECK-NEXT:   S_WAITCNT .Vmcnt_0
# CHECK-NEXT:   DS_WRITE_B32

---
name: vmcnt_ds_consumer
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7, $vgpr0, $vgpr0_vgpr1
    renamable $vgpr2 = BUFFER_LOAD_DWORD_ADDR64 renamable $vgpr0_vgpr1, renamable $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (load (s32), addrspace 1)
    renamable $vgpr1 = BUFFER_LOAD_DWORD_ADDR64 renamable $vgpr0_vgpr1, killed renamable $sgpr4_sgpr5_sgpr6_sgpr7, 0, 0, 0, 0, implicit $exec :: (load (s32), addrspace 1)
    $m0 = S_MOV_B32 -1
    DS_WRITE_B32 renamable $vgpr0, killed renamable $vgpr2, 0, 0, implicit $m0, implicit $exec :: (store (s32), addrspace 3)
    DS_WRITE_B32 killed renamable $vgpr0, killed renamable $vgpr1, 1028, 0, implicit $m0, implicit $exec :: (store (s32), addrspace 3)
    S_ENDPGM 0
...
