---
# IMAGE_SAMPLE -> BUFFER_STORE that stores the sampled value (Use), with an
# unrelated store pending in between and a second IMAGE_SAMPLE as Filler (same
# counter as Def, to create a position gap). The Use is a store: it consumes
# Def's result but produces no VMEM result of its own, so its VmemType
# (NOSAMPLER) is irrelevant and a position-based wait is legal even though Def is
# SAMPLER. The wait counts down to Def's position.
# On gfx9 the samples and pending store all share vmcnt -> vmcnt 2.
# On gfx10/gfx11 stores use vscnt, so only the two samples are on vmcnt -> vmcnt 1.
# On gfx12+ the samples use samplecnt -> samplecnt 1.
name: sample_store_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr10, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX9-LABEL: name: sample_store_store
    ; GFX9: IMAGE_SAMPLE_V1_V2
    ; GFX9-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr10
    ; GFX9-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX9-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr5
    ;
    ; GFX10-LABEL: name: sample_store_store
    ; GFX10: IMAGE_SAMPLE_V1_V2
    ; GFX10-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr10
    ; GFX10-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr5
    ;
    ; GFX11-LABEL: name: sample_store_store
    ; GFX11: IMAGE_SAMPLE_V1_V2
    ; GFX11-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr10
    ; GFX11-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr5
    ;
    ; GFX12-LABEL: name: sample_store_store
    ; GFX12: IMAGE_SAMPLE_V1_V2
    ; GFX12-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr10
    ; GFX12-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX12-NEXT: S_WAIT_SAMPLECNT 1
    ; GFX12-NEXT: BUFFER_STORE_DWORD_OFFSET $vgpr5
    $vgpr5 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))  ; Def
    BUFFER_STORE_DWORD_OFFSET $vgpr10, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (store (s32), addrspace 8)  ; Pending
    $vgpr6 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))  ; Filler
    BUFFER_STORE_DWORD_OFFSET $vgpr5, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (store (s32), addrspace 8)   ; Use
    S_ENDPGM 0
...

