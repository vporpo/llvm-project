# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX9
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX9
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX10
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX10
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX11
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX11
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12

# Test Counter::isNonZeroWaitLegal() with pending instructions IN BETWEEN Def and Filler.
#
# These tests verify behavior when there are other pending instructions besides
# the Def and Use. The pending instruction is placed between Def and Filler:
#   Def (defines a value we need to wait for)
#   Pending (extra instruction)
#   Filler (same counter as Def - creates position gap)
#   Use (uses Def's result, triggers the wait)
#
# For VMEM-only instructions, the in-order guarantee is between SrcMI and DstMI
# based on their VmemTypes - other pending instructions with different VmemTypes
# don't affect the in-order decision for this pair.
#
# For DS on GFX12+, mixed LDS+GDS types break in-order guarantee.
#
# ============================================================================
# Test Summary Table
# ============================================================================
#
# | Test Name                    | Def    | Pending  | Filler | GFX9-11              | GFX12            |
# |------------------------------|--------|----------|--------|----------------------|------------------|
# | global_sampler_global        | GLOBAL | SAMPLE   | GLOBAL | vm 2                 | load 1           |
# | image_load_sampler_image_load| IMGLD  | SAMPLE   | IMGLD  | vm 2                 | load 1           |
# | global_flat_global           | GLOBAL | FLAT     | GLOBAL | vm 0/2 (*)           | load 2           |
# | global_global_global_global  | GLOBAL | 2xGLOBAL | GLOBAL | vm 3                 | load 3           |
# | ds_smem_ds                   | DS     | SMEM     | DS     | lgkm 0               | ds 1             |
# | ds_flat_ds                   | DS     | FLAT     | DS     | lgkm 0/2 (*)         | ds 2             |
# | sample_image_load_sample     | SAMPLE | IMGLD    | SAMPLE | vm 2                 | sample 1         |
# | image_load_sample_image_load | IMGLD  | SAMPLE   | IMGLD  | vm 2                 | load 1           |
# | flat_global_flat             | FLAT   | GLOBAL   | FLAT   | vm 0/2, lgkm 0/1     | load 2, ds 1     |
# | smem_ds_smem                 | SMEM   | DS       | SMEM   | lgkm 0               | km 0             |
# | flat_ds_flat                 | FLAT   | DS       | FLAT   | vm 1, lgkm 0/2       | load 1, ds 2     |
# | smem_flat_smem               | SMEM   | FLAT     | SMEM   | lgkm 0               | km 0             |
# | flat_smem_flat               | FLAT   | SMEM     | FLAT   | vm 0/1, lgkm 0       | load 1, ds 1     |
# | sample_store_store           | SAMPLE | STORE    | SAMPLE | vm 2/1 (**)          | sample 1         |
# | bvh_store_store              | BVH    | STORE    | BVH    | vm 2/1 (**)          | bvh 1            |
#
# (*) FLAT mixed with VMEM-only/DS: GFX9 uses vmcnt/lgkmcnt 0, GFX10+ uses
#     position-based waits. Use -amdgpu-strict-mixed-flat-check for cnt 0
#     behavior on all targets.
# (**) The Use is a store, so its VmemType is irrelevant and a position-based
#     wait is legal despite Def being SAMPLER/BVH. GFX9 shares vmcnt across the
#     Def, Filler and pending store (vm 2); GFX10/11 put stores on vscnt, so only
#     Def and Filler are pending on vmcnt (vm 1).
#
# ============================================================================

---
# GLOBAL → GLOBAL with IMAGE_SAMPLE pending (NOSAMPLER pair, SAMPLER also pending)
# The GLOBAL loads are both NOSAMPLER, so they complete in-order with each other.
# The pending IMAGE_SAMPLE doesn't affect GLOBAL→GLOBAL ordering.
# Expected: vmcnt 2 (GFX9-11), loadcnt 1 (GFX12 - separate counter)
name: global_sampler_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX9-LABEL: name: global_sampler_global
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_sampler_global
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: global_sampler_global
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: global_sampler_global
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec                                                                  ; Def
    $vgpr4 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Pending
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec                                                                  ; Filler
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec                                                                                  ; Use
...

---
# IMAGE_LOAD → IMAGE_LOAD with IMAGE_SAMPLE pending (NOSAMPLER pair, SAMPLER pending)
# The IMAGE_LOADs are both NOSAMPLER, so they complete in-order with each other.
# The pending IMAGE_SAMPLE doesn't affect IMAGE_LOAD→IMAGE_LOAD ordering.
# Expected: vmcnt 2 (GFX9-11), loadcnt 1 (GFX12)
name: image_load_sampler_image_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX9-LABEL: name: image_load_sampler_image_load
    ; GFX9: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX9-NEXT: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX9-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: image_load_sampler_image_load
    ; GFX10: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX10-NEXT: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX10-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: image_load_sampler_image_load
    ; GFX11: IMAGE_LOAD_V1_V4
    ; GFX11-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX11-NEXT: IMAGE_LOAD_V1_V4
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX11-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: image_load_sampler_image_load
    ; GFX12: IMAGE_LOAD_V1_V4
    ; GFX12-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX12-NEXT: IMAGE_LOAD_V1_V4
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr4 = V_MOV_B32
    $vgpr4 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Def
    $vgpr6 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Pending
    $vgpr5 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Filler
    $vgpr4 = V_MOV_B32_e32 $vgpr4, implicit $exec                       ; Use
...

---
# GLOBAL → GLOBAL with FLAT pending
# FLAT can complete out of order relative to VMEM-only instructions.
# Pre-GFX10 old pass: vmcnt 0 (conservative). GFX10+: vmcnt 2 (position-based).
# Strict mode (-amdgpu-strict-mixed-flat-check): vmcnt 0 (correct).
name: global_flat_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: global_flat_global
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_flat_global
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: global_flat_global
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: global_flat_global
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 2
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec                            ; Def
    $vgpr4 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr          ; Pending
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec                            ; Filler
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec                                           ; Use
...

---
# GLOBAL → GLOBAL with multiple GLOBALs pending (testing count > 2)
# All are NOSAMPLER, so they complete in-order. Wait count should be 3.
# Expected: vmcnt 3 (GFX9-11), loadcnt 3 (GFX12)
name: global_global_global_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: global_global_global_global
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_3
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_global_global_global
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_3
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: global_global_global_global
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_3
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: global_global_global_global
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 3
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec   ; Def
    $vgpr4 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 8, 0, implicit $exec   ; Pending
    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 12, 0, implicit $exec  ; Pending
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec   ; Filler
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec                   ; Use
...

---
# DS_READ → DS_READ with SMEM pending
# On pre-GFX12, both DS and SMEM use lgkmcnt. The old pass is conservative and
# waits for 0 when mixed instruction types are pending on lgkmcnt.
# On GFX12, DS uses dscnt, SMEM uses kmcnt - separate counters.
# Expected: lgkmcnt 0 (GFX9-11, conservative), dscnt 1 (GFX12)
name: ds_smem_ds
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1, $m0
    ; GFX9-LABEL: name: ds_smem_ds
    ; GFX9: DS_READ_B32
    ; GFX9-NEXT: $sgpr2 = S_LOAD_DWORD_IMM
    ; GFX9-NEXT: DS_READ_B32
    ; GFX9-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: ds_smem_ds
    ; GFX10: DS_READ_B32
    ; GFX10-NEXT: $sgpr2 = S_LOAD_DWORD_IMM
    ; GFX10-NEXT: DS_READ_B32
    ; GFX10-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: ds_smem_ds
    ; GFX11: DS_READ_B32
    ; GFX11-NEXT: $sgpr2 = S_LOAD_DWORD_IMM
    ; GFX11-NEXT: DS_READ_B32
    ; GFX11-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: ds_smem_ds
    ; GFX12: DS_READ_B32
    ; GFX12-NEXT: $sgpr2 = S_LOAD_DWORD_IMM
    ; GFX12-NEXT: DS_READ_B32
    ; GFX12-NEXT: S_WAIT_DSCNT 1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0   ; Def
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0 :: (load (s32))           ; Pending
    $vgpr3 = DS_READ_B32_gfx9 $vgpr0, 4, 0, implicit $exec, implicit $m0   ; Filler
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec                          ; Use
...

---
# DS_READ → DS_READ with FLAT pending
# On pre-GFX12, FLAT's LDS path uses lgkmcnt. GFX9 conservatively waits for 0,
# but GFX10+ uses position-based waits (matches old pass behavior).
# On GFX12, FLAT uses dscnt for LDS path - same counter as DS.
# Strict mode: lgkmcnt 0 (correct). Default: lgkmcnt 2 (matches old pass).
name: ds_flat_ds
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr4_vgpr5, $m0
    ; GFX9-LABEL: name: ds_flat_ds
    ; GFX9: DS_READ_B32
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: DS_READ_B32
    ; GFX9-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: ds_flat_ds
    ; GFX10: DS_READ_B32
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: DS_READ_B32
    ; GFX10-NEXT: S_WAITCNT .Lgkmcnt_2
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: ds_flat_ds
    ; GFX11: DS_READ_B32
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: DS_READ_B32
    ; GFX11-NEXT: S_WAITCNT .Lgkmcnt_2
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: ds_flat_ds
    ; GFX12: DS_READ_B32
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: DS_READ_B32
    ; GFX12-NEXT: S_WAIT_DSCNT 2
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0              ; Def
    $vgpr6 = FLAT_LOAD_DWORD $vgpr4_vgpr5, 0, 0, implicit $exec, implicit $flat_scr   ; Pending
    $vgpr3 = DS_READ_B32_gfx9 $vgpr0, 4, 0, implicit $exec, implicit $m0              ; Filler
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec                                     ; Use
...

---
# IMAGE_SAMPLE → IMAGE_SAMPLE with IMAGE_LOAD pending (inverse of image_load with sampler)
# Different VmemTypes (SAMPLER vs NOSAMPLER) can complete out of order.
# Expected: vmcnt 1 (GFX9-11), samplecnt 1 (GFX12)
name: sample_image_load_sample
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX9-LABEL: name: sample_image_load_sample
    ; GFX9: IMAGE_SAMPLE
    ; GFX9-NEXT: IMAGE_LOAD
    ; GFX9-NEXT: IMAGE_SAMPLE
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX9-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX10-LABEL: name: sample_image_load_sample
    ; GFX10: IMAGE_SAMPLE
    ; GFX10-NEXT: IMAGE_LOAD
    ; GFX10-NEXT: IMAGE_SAMPLE
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX10-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX11-LABEL: name: sample_image_load_sample
    ; GFX11: IMAGE_SAMPLE
    ; GFX11-NEXT: IMAGE_LOAD
    ; GFX11-NEXT: IMAGE_SAMPLE
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX11-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX12-LABEL: name: sample_image_load_sample
    ; GFX12: IMAGE_SAMPLE
    ; GFX12-NEXT: IMAGE_LOAD
    ; GFX12-NEXT: IMAGE_SAMPLE
    ; GFX12-NEXT: S_WAIT_SAMPLECNT 1
    ; GFX12-NEXT: $vgpr5 = V_MOV_B32_e32
    $vgpr5 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Def
    $vgpr4 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Pending
    $vgpr6 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Filler
    $vgpr5 = V_MOV_B32_e32 $vgpr5, implicit $exec                       ; Use
...

---
# IMAGE_LOAD → IMAGE_LOAD with IMAGE_SAMPLE pending (reverse of above)
# Different VmemTypes (NOSAMPLER vs SAMPLER) can complete out of order.
# Expected: vmcnt 1 (GFX9-11), loadcnt 1 (GFX12)
name: image_load_sample_image_load
body: |
  bb.0:
    ; GFX9-LABEL: name: image_load_sample_image_load
    ; GFX9: IMAGE_LOAD
    ; GFX9-NEXT: IMAGE_SAMPLE
    ; GFX9-NEXT: IMAGE_LOAD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX9-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX10-LABEL: name: image_load_sample_image_load
    ; GFX10: IMAGE_LOAD
    ; GFX10-NEXT: IMAGE_SAMPLE
    ; GFX10-NEXT: IMAGE_LOAD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX10-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX11-LABEL: name: image_load_sample_image_load
    ; GFX11: IMAGE_LOAD
    ; GFX11-NEXT: IMAGE_SAMPLE
    ; GFX11-NEXT: IMAGE_LOAD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_2
    ; GFX11-NEXT: $vgpr5 = V_MOV_B32_e32
    ;
    ; GFX12-LABEL: name: image_load_sample_image_load
    ; GFX12: IMAGE_LOAD
    ; GFX12-NEXT: IMAGE_SAMPLE
    ; GFX12-NEXT: IMAGE_LOAD
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr5 = V_MOV_B32_e32
    $vgpr5 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32)) ; Def
