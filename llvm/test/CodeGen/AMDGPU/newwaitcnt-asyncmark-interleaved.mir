# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

---
name: asyncmark_interleaved
machineFunctionInfo:
    isEntryFunction: true
body: |
    bb.0:
      liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $vgpr0, $vgpr1_vgpr2

      ; Batch 1: LDS DMA immediately followed by ASYNCMARK (works today).
    ; CHECK-LABEL: name: asyncmark_interleaved
    ; CHECK: liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, 1, implicit $exec, implicit $m0
    ; CHECK-NEXT: ASYNCMARK implicit $exec
    ; CHECK-NEXT: BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, 1, implicit $exec, implicit $m0
    ; CHECK-NEXT: $vgpr3 = GLOBAL_LOAD_DWORD $vgpr1_vgpr2, 0, 0, implicit $exec
    ; CHECK-NEXT: ASYNCMARK implicit $exec
    ; CHECK-NEXT: WAIT_ASYNCMARK 1, implicit $exec
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_2
    ; CHECK-NEXT: $vgpr4 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0
    ; CHECK-NEXT: WAIT_ASYNCMARK 0, implicit $exec
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    ; CHECK-NEXT: $vgpr5 = DS_READ_B32_gfx9 $vgpr0, 4, 0, implicit $exec, implicit $m0
    ; CHECK-NEXT: S_ENDPGM 0
      BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, 1, implicit $exec, implicit $m0
      ASYNCMARK implicit $exec

      ; Batch 2: LDS DMA, then a regular vmem load, then ASYNCMARK.
      ; ASYNCMARK_2 is NOT immediately after LDS_DMA_2.
      BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, 1, implicit $exec, implicit $m0
      $vgpr3 = GLOBAL_LOAD_DWORD $vgpr1_vgpr2, 0, 0, implicit $exec
      ASYNCMARK implicit $exec

      ; OLD:      WAIT_ASYNCMARK 1
      ; OLD-NEXT: S_WAITCNT .Vmcnt_3
      ; NEW:      WAIT_ASYNCMARK 1
      ; NEW-NEXT: S_WAITCNT .Vmcnt_3
      WAIT_ASYNCMARK 1, implicit $exec
      $vgpr4 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0

      ; OLD:      WAIT_ASYNCMARK 0
      ; OLD-NEXT: S_WAITCNT .Vmcnt_1
      ; NEW:      WAIT_ASYNCMARK 0
      ; NEW-NEXT: S_WAITCNT .Vmcnt_1
      WAIT_ASYNCMARK 0, implicit $exec
      $vgpr5 = DS_READ_B32_gfx9 $vgpr0, 4, 0, implicit $exec, implicit $m0

      S_ENDPGM 0
...
