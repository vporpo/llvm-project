# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# In expert scheduling mode 2, VMEM instructions hold their VGPR source
# registers on the VmVsrc counter until the address is read. A VALU that
# overwrites the same VGPR needs a depctr_vm_vsrc(0) wait first.
# Here FLAT_LOAD reads $vgpr0_vgpr1 as address, then V_MOV overwrites $vgpr0.

# CHECK-LABEL: name: esm2_vmvsrc
# CHECK:        FLAT_LOAD_DWORD
# CHECK:        S_WAITCNT_DEPCTR
# CHECK:        V_MOV_B32_e32 {{.*}}, implicit $exec
# CHECK:        S_SETPC_B64_return

---
name: esm2_vmvsrc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $sgpr30_sgpr31
    renamable $vgpr2 = FLAT_LOAD_DWORD renamable $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0, implicit $vgpr2
...
