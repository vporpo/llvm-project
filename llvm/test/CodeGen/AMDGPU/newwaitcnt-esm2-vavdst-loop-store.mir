# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# In a loop, two VALUs write different VGPRs. FLAT_LOAD uses the first
# VALU's result (v0_v1) as address. FLAT_STORE uses the second VALU's
# result (v4_v5) as address. After the VaVdst_1 wait before FLAT_LOAD,
# one VALU result (v4/v5) is still pending. A VaVdst_0 wait must appear
# before FLAT_STORE to ensure v4/v5 are ready.

# CHECK-LABEL: name: vavdst_loop_store
# CHECK:      bb.1:
# CHECK:        V_MOV_B32
# CHECK:        V_MOV_B32
# CHECK:        V_MOV_B32
# CHECK:        V_MOV_B32
# CHECK:        S_WAITCNT_DEPCTR
# CHECK-NEXT:   FLAT_LOAD_DWORD
# CHECK:        S_WAITCNT_DEPCTR
# CHECK-NEXT:   FLAT_STORE_DWORD

---
name: vavdst_loop_store
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $sgpr1, $sgpr2, $sgpr3, $sgpr4
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $sgpr1, $sgpr2, $sgpr3, $sgpr4
    $vgpr0 = V_MOV_B32_e32 $sgpr0, implicit $exec
    $vgpr1 = V_MOV_B32_e32 $sgpr1, implicit $exec
    $vgpr4 = V_MOV_B32_e32 $sgpr2, implicit $exec
    $vgpr5 = V_MOV_B32_e32 $sgpr3, implicit $exec
    renamable $vgpr2 = FLAT_LOAD_DWORD renamable $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))
    S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    FLAT_STORE_DWORD renamable $vgpr4_vgpr5, killed renamable $vgpr2, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32))
    $sgpr4 = S_ADD_I32 killed $sgpr4, -1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
