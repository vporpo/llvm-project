# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On pre-gfx10, a pure FLAT increments both VmCnt and LgkmCnt because the
# hardware doesn't know at compile time whether it takes the VMEM or LDS path.
# The early completion bug means VmCnt can decrement before the data is ready,
# so vmcnt(0) is required while a FLAT is pending.
#
# The old pass's hasPendingFlat() checks whether a FLAT's score is still within
# range on EITHER the VmCnt OR LgkmCnt counter. Here the FLAT_STORE's VmCnt
# side is drained by vmcnt(0) before V_READLANE_B32, but its LgkmCnt side is
# never drained. So hasPendingFlat() returns true at V_READFIRSTLANE_B32,
# forcing vmcnt(0) even though only non-FLAT BUFFER_LOADs are pending on VmCnt.
#
# The new pass only checks instructions currently in the VmCnt buffer. The
# FLAT_STORE was removed from VmCnt by the drain, so hasPendingFlat returns
# false. The subsequent BUFFER_LOADs complete in order, so vmcnt(1) is correct.

# CHECK-LABEL: name: flat_sticky_pending
# CHECK:      S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
# CHECK-NEXT: FLAT_STORE_DWORDX4
# CHECK-NEXT: $vgpr2 = BUFFER_LOAD_DWORD_OFFSET
# CHECK-NEXT: S_WAITCNT .Vmcnt_0
# CHECK-NEXT: $sgpr4 = V_READLANE_B32
# CHECK-NEXT: $vgpr0 = BUFFER_LOAD_DWORD_OFFSET
# CHECK-NEXT: $vgpr40 = BUFFER_LOAD_DWORD_OFFSET
# CHECK-NEXT: S_WAITCNT .Vmcnt_0
# CHECK-NEXT: $sgpr6 = V_READFIRSTLANE_B32

---
name: flat_sticky_pending
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr30_sgpr31, $sgpr33, $vgpr0_vgpr1, $vgpr4_vgpr5_vgpr6_vgpr7

    FLAT_STORE_DWORDX4 killed renamable $vgpr0_vgpr1, killed renamable $vgpr4_vgpr5_vgpr6_vgpr7, 0, 0, implicit $exec, implicit $flat_scr :: (volatile store (s128))
    $vgpr2 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr33, 0, 0, 0, implicit $exec
    $sgpr4 = V_READLANE_B32 killed $vgpr2, 0
    $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr33, 4, 0, 0, implicit $exec
    $vgpr40 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr33, 8, 0, 0, implicit $exec
    $sgpr6 = V_READFIRSTLANE_B32 killed $vgpr0, implicit $exec
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
