# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# Interleaved async LDS DMA and regular VMEM loads, each followed by ASYNCMARK.
# WAIT_ASYNCMARK(1) waits for the 2nd mark from end (the LDS DMA load):
# vmcnt must be <= 1 (regular load still in flight above).
# WAIT_ASYNCMARK(0) waits for the 1st mark from end (the regular VMEM load):
# vmcnt must be <= 0 (all loads complete).
#
---
name: asyncmark_mixed_marks
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; Async LDS DMA (goes into VmCnt, followed by ASYNCMARK = mark 1 from end)
    ; CHECK-LABEL: name: asyncmark_mixed_marks
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ; CHECK-NEXT: ASYNCMARK implicit $exec
    ; CHECK-NEXT: $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
    ; CHECK-NEXT: ASYNCMARK implicit $exec
    ; CHECK-NEXT: WAIT_ASYNCMARK 1, implicit $exec
    ; CHECK-NEXT: WAIT_ASYNCMARK 0, implicit $exec
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    ; CHECK-NEXT: S_ENDPGM 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK implicit $exec
    ; Regular VMEM load (goes into VmCnt, followed by ASYNCMARK = mark 0 from end)
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
    ASYNCMARK implicit $exec
    WAIT_ASYNCMARK 1, implicit $exec
    WAIT_ASYNCMARK 0, implicit $exec
    S_ENDPGM 0
...
