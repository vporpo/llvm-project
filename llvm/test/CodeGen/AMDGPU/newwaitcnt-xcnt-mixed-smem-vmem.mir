# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Test XCnt WAR hazard with mixed SMEM and VMEM pending from different paths.
#
# XCnt tracks address translation for both VMEM and SMEM on gfx1250.
# VMEM address translation completes in order, but SMEM can complete out of
# order. When a block has potentially pending SMEM (from one path) and VMEM
# (from another path), the XCnt counter can decrement out of order, making
# position-based waits unsafe.
#
# In this test:
# - bb.0: S_LOAD_DWORD_IMM (SMEM) then branch
# - bb.1: GLOBAL_LOADs (VMEM) using $vgpr0_vgpr1, $vgpr2_vgpr3
# - bb.2: $vgpr1 = V_MOV (WAR on $vgpr1 from bb.1 GLOBAL_LOAD)
#
# At bb.2, XCnt might have SMEM (from bb.0) or VMEM (from bb.1) pending.
# Since SMEM can complete out of order, we must wait xcnt=0 even though
# the dependency is on a VMEM instruction.

---
name: xcnt_mixed_smem_vmem_paths
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: xcnt_mixed_smem_vmem_paths
  ; CHECK: bb.2:
  ; CHECK-NEXT: liveins:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: S_WAIT_XCNT 1
  ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 0
  ; CHECK-NEXT: S_WAIT_XCNT 0
  bb.0:
    liveins: $vgpr0_vgpr1, $sgpr0_sgpr1, $scc
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    S_CBRANCH_SCC1 %bb.2, implicit $scc
  bb.1:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr2
    $vgpr4 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
  bb.2:
    liveins: $sgpr0_sgpr1, $sgpr2, $vgpr2
    $vgpr1 = V_MOV_B32_e32 0, implicit $exec
    $vgpr2 = V_MOV_B32_e32 0, implicit $exec
    $sgpr0 = S_MOV_B32 $sgpr0
...
