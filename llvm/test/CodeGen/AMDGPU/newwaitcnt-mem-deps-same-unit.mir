# CHECK-NEXT: S_ENDPGM
name: scratch_store_load_diff_addr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr0_sgpr1
    SCRATCH_STORE_DWORD $vgpr1, $vgpr0, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr3 = SCRATCH_LOAD_DWORD $vgpr2, 0, 0, implicit $exec, implicit $flat_scr
    S_ENDPGM 0
...

