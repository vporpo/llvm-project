tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    DS_WRITE_B32_gfx9 $vgpr0, $vgpr1, 0, 0, implicit $exec
    $vgpr3 = DS_READ_B32_gfx9 $vgpr2, 0, 0, implicit $exec
    S_ENDPGM 0
...
