#############################################################################
# WAR (store-after-load), same address
#############################################################################

---
# CHECK-LABEL: name: ds_read_write
# CHECK: DS_READ_B32_gfx9
# CHECK-NEXT: DS_WRITE_B32_gfx9
# CHECK-NEXT: S_ENDPGM
name: ds_read_write
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    $vgpr2 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr0, $vgpr1, 0, 0, implicit $exec
    S_ENDPGM 0
...
---
# CHECK-LABEL: name: vmem_load_store
# CHECK: BUFFER_LOAD_DWORD_OFFEN
# CHECK-NEXT: BUFFER_STORE_DWORD_OFFEN
# CHECK-NEXT: S_ENDPGM
name: vmem_load_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3
    $vgpr2 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN $vgpr1, $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    S_ENDPGM 0
...
---
# CHECK-LABEL: name: global_load_store
# CHECK: GLOBAL_LOAD_DWORD
# CHECK-NEXT: GLOBAL_STORE_DWORD
# CHECK-NEXT: S_ENDPGM
name: global_load_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    S_ENDPGM 0
...
---
# CHECK-LABEL: name: flat_load_store
# CHECK: FLAT_LOAD_DWORD
# CHECK-NEXT: FLAT_STORE_DWORD
# CHECK-NEXT: S_ENDPGM
name: flat_load_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    FLAT_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec, implicit $flat_scr
    S_ENDPGM 0
...
---
# CHECK-LABEL: name: scratch_load_store
# CHECK: SCRATCH_LOAD_DWORD
# CHECK-NEXT: SCRATCH_STORE_DWORD
# CHECK-NEXT: S_ENDPGM
name: scratch_load_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
    $vgpr2 = SCRATCH_LOAD_DWORD $vgpr0, 0, 0, implicit $exec, implicit $flat_scr
    SCRATCH_STORE_DWORD $vgpr1, $vgpr0, 0, 0, implicit $exec, implicit $flat_scr
    S_ENDPGM 0
...

