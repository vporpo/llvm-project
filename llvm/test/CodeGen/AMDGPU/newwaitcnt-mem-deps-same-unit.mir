name: global_store_load_diff_addr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2, $vgpr3_vgpr4
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec
    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr3_vgpr4, 0, 0, implicit $exec
