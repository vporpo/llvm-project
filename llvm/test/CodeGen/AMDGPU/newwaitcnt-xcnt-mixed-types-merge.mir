# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# FIXME: New pass incorrectly forces xcnt=0 when merged state has mixed types.
# RUN-TODO: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Test that XCnt waits are computed correctly when SMEM and VMEM entries
# are merged from different CFG paths.
#
# CFG:
#   bb.0: SMEM load, branch to bb.2 or fall through to bb.1
#   bb.1: 2 VMEM loads
#   bb.2: WAR on VMEM addresses
#
# At bb.2 merge:
#   - From bb.0→bb.2: XCnt has [SMEM]
#   - From bb.1→bb.2: XCnt has [VMEM1, VMEM2]
#   - Merged: XCnt has [VMEM1, SMEM, VMEM2]
#
# The presence of SMEM in merged state triggers hasMixedEventTypes() which
# forces xcnt=0. But the bb.1→bb.2 path only has VMEMs pending, so position-
# based waits should work. The SMEM from bb.0→bb.2 should not affect VMEM waits.

---
name: xcnt_mixed_types_merge
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: xcnt_mixed_types_merge
  ; CHECK: bb.0:
  ; CHECK:      $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
  ; CHECK-NEXT: S_CBRANCH_SCC1 %bb.2, implicit $scc

  ; CHECK: bb.1:
  ; CHECK:      $vgpr4 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1
  ; CHECK-NEXT: $vgpr5 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3

  ; CHECK: bb.2:
  ; CHECK:      S_WAIT_KMCNT 0
  ; CHECK-NEXT: $sgpr2 = S_MOV_B32 $sgpr2
  ; CHECK-NEXT: S_WAIT_XCNT 1
  ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 0
  ; CHECK-NEXT: S_WAIT_XCNT 0
  ; CHECK-NEXT: $vgpr2 = V_MOV_B32_e32 0
  ; CHECK-NEXT: $sgpr0 = S_MOV_B32 $sgpr0
  bb.0:
    liveins: $vgpr0_vgpr1, $sgpr0_sgpr1, $scc
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr2
    $vgpr4 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec

  bb.2:
    liveins: $sgpr0_sgpr1, $sgpr2, $vgpr2
    $sgpr2 = S_MOV_B32 $sgpr2
    $vgpr1 = V_MOV_B32_e32 0, implicit $exec
    $vgpr2 = V_MOV_B32_e32 0, implicit $exec
    $sgpr0 = S_MOV_B32 $sgpr0
...
