# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Test that counter merge order doesn't affect wait values.
# This tests the diamond CFG pattern where two paths merge.
# The merge should produce consistent results regardless of predecessor order.

---
name: merge_order_test
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: merge_order_test
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0_vgpr1, $sgpr0

    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    ; Path A: one load
    successors: %bb.3
    liveins: $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    ; Path B: two loads (more pending)
    successors: %bb.3
    liveins: $vgpr0_vgpr1

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    ; Merge point - uses vgpr2 which was loaded on both paths
    ; Should wait for vgpr2's load regardless of merge order
    liveins: $vgpr2

    ; CHECK: bb.3:
    ; CHECK: S_WAITCNT
    ; CHECK-NEXT: $vgpr4 = V_MOV_B32_e32 $vgpr2
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...
