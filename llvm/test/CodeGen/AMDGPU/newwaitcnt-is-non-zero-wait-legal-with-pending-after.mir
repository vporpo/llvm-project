---
# FLAT -> FLAT with GLOBAL pending after Use
# FLAT can complete out of order on GFX9, so wait is 0. GFX10+ allows non-zero waits.
# Expected: vmcnt 0, lgkmcnt 0 (GFX9), vmcnt 1, lgkmcnt 1 (GFX10-11), loadcnt 1, dscnt 1 (GFX12)
name: flat_flat_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: flat_flat_global
    ; GFX9: FLAT_LOAD_DWORD
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX9-NEXT: $vgpr4 = V_MOV_B32_e32
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX10-LABEL: name: flat_flat_global
    ; GFX10: FLAT_LOAD_DWORD
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX10-NEXT: $vgpr4 = V_MOV_B32_e32
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX11-LABEL: name: flat_flat_global
    ; GFX11: FLAT_LOAD_DWORD
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX11-NEXT: $vgpr4 = V_MOV_B32_e32
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX12-LABEL: name: flat_flat_global
    ; GFX12: FLAT_LOAD_DWORD
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_1_Dscnt_1
    ; GFX12-NEXT: $vgpr4 = V_MOV_B32_e32
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    $vgpr4 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr   ; Def
    $vgpr5 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr   ; Filler
    $vgpr4 = V_MOV_B32_e32 $vgpr4, implicit $exec                                     ; Use
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec                     ; Pending
...

---
# SMEM → SMEM with DS pending after Use
# SMEM instructions can complete out of order, so wait is 0.
# Expected: lgkmcnt 0 (GFX9-11), kmcnt 0 (GFX12)
name: smem_smem_ds
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1, $m0
    ; GFX9-LABEL: name: smem_smem_ds
    ; GFX9: S_LOAD_DWORD_IMM
    ; GFX9-NEXT: S_LOAD_DWORD_IMM
    ; GFX9-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX9-NEXT: $sgpr2 = S_MOV_B32
    ; GFX9-NEXT: DS_READ_B32
    ;
    ; GFX10-LABEL: name: smem_smem_ds
    ; GFX10: S_LOAD_DWORD_IMM
    ; GFX10-NEXT: S_LOAD_DWORD_IMM
    ; GFX10-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX10-NEXT: $sgpr2 = S_MOV_B32
    ; GFX10-NEXT: DS_READ_B32
    ;
    ; GFX11-LABEL: name: smem_smem_ds
    ; GFX11: S_LOAD_DWORD_IMM
    ; GFX11-NEXT: S_LOAD_DWORD_IMM
    ; GFX11-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX11-NEXT: $sgpr2 = S_MOV_B32
    ; GFX11-NEXT: DS_READ_B32
    ;
    ; GFX12-LABEL: name: smem_smem_ds
    ; GFX12: S_LOAD_DWORD_IMM
    ; GFX12-NEXT: S_LOAD_DWORD_IMM
    ; GFX12-NEXT: S_WAIT_KMCNT 0
    ; GFX12-NEXT: $sgpr2 = S_MOV_B32
    ; GFX12-NEXT: DS_READ_B32
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0 :: (load (s32))           ; Def
    $sgpr3 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 4, 0 :: (load (s32))           ; Filler
    $sgpr2 = S_MOV_B32 $sgpr2                                              ; Use
    $vgpr2 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0   ; Pending
...

---
# FLAT -> FLAT with DS pending after Use
# FLAT can complete out of order on GFX9, so wait is 0. GFX10+ allows non-zero waits.
# Expected: vmcnt 0, lgkmcnt 0 (GFX9), vmcnt 1, lgkmcnt 1 (GFX10-11), loadcnt 1, dscnt 1 (GFX12)
name: flat_flat_ds
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr4_vgpr5, $m0
    ; GFX9-LABEL: name: flat_flat_ds
    ; GFX9: FLAT_LOAD_DWORD
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX9-NEXT: $vgpr6 = V_MOV_B32_e32
    ; GFX9-NEXT: DS_READ_B32
    ;
    ; GFX10-LABEL: name: flat_flat_ds
    ; GFX10: FLAT_LOAD_DWORD
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX10-NEXT: $vgpr6 = V_MOV_B32_e32
    ; GFX10-NEXT: DS_READ_B32
    ;
    ; GFX11-LABEL: name: flat_flat_ds
    ; GFX11: FLAT_LOAD_DWORD
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX11-NEXT: $vgpr6 = V_MOV_B32_e32
    ; GFX11-NEXT: DS_READ_B32
    ;
    ; GFX12-LABEL: name: flat_flat_ds
    ; GFX12: FLAT_LOAD_DWORD
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_1_Dscnt_1
    ; GFX12-NEXT: $vgpr6 = V_MOV_B32_e32
    ; GFX12-NEXT: DS_READ_B32
    $vgpr6 = FLAT_LOAD_DWORD $vgpr4_vgpr5, 0, 0, implicit $exec, implicit $flat_scr   ; Def
    $vgpr7 = FLAT_LOAD_DWORD $vgpr4_vgpr5, 4, 0, implicit $exec, implicit $flat_scr   ; Filler
    $vgpr6 = V_MOV_B32_e32 $vgpr6, implicit $exec                                     ; Use
    $vgpr2 = DS_READ_B32_gfx9 $vgpr0, 0, 0, implicit $exec, implicit $m0              ; Pending
...

