    ; GFX12-NEXT: S_WAIT_KMCNT 0
    ; GFX12-NEXT: $sgpr2 = S_MOV_B32
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    $sgpr2 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 0, 0 :: (load (s32))                      ; Def
    $sgpr3 = S_LOAD_DWORD_IMM $sgpr0_sgpr1, 4, 0 :: (load (s32))                      ; Filler
