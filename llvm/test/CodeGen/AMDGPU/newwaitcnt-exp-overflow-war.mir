# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# An export holds its source VGPRs on the export counter (ExpCnt), so overwriting
# a source is a write-after-read hazard that needs an ExpCnt wait. ExpCnt on gfx9
# can track at most 7 outstanding exports, though.
#
# - exp_war_at_max: exactly 7 exports pending. The first one (reading $vgpr0) is
#   the oldest trackable entry (position 6), so overwriting $vgpr0 waits expcnt 6.
# - exp_war_overflow: 8 exports pending. The first one has overflowed out of the
#   trackable window; its source read is therefore complete and no ExpCnt wait is
#   emitted for it.

---
name: exp_war_at_max
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: exp_war_at_max
    ; CHECK: EXP 0, $vgpr0, $vgpr0, $vgpr0, $vgpr0
    ; CHECK: S_WAITCNT {{.*}}Expcnt_6
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 1
    EXP 0, $vgpr0, $vgpr0, $vgpr0, $vgpr0, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    S_ENDPGM 0
...

---
name: exp_war_overflow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: exp_war_overflow
    ; CHECK: EXP 0, $vgpr0, $vgpr0, $vgpr0, $vgpr0
    ; CHECK-NOT: S_WAITCNT {{.*}}Expcnt
    ; CHECK: $vgpr0 = V_MOV_B32_e32 1
    EXP 0, $vgpr0, $vgpr0, $vgpr0, $vgpr0, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    EXP 0, $vgpr1, $vgpr1, $vgpr1, $vgpr1, -1, -1, 15, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    S_ENDPGM 0
...
