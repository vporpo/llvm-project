# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

---
name: loop_merge
body: |
  bb.0:
    successors: %bb.1

    $vgpr4 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr5 = V_MOV_B32_e32 $vgpr4, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1

  ; CHECK-LABEL: bb.1:
  ; CHECK: S_WAITCNT .Vmcnt_1
  ; CHECK-NEXT: $vgpr6 = V_MOV_B32_e32 $vgpr5, implicit $exec

    $vgpr6 = V_MOV_B32_e32 $vgpr5, implicit $exec
    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    S_BRANCH %bb.1
...
