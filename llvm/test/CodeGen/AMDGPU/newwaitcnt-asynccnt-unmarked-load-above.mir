# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# GFX1250: async load followed by ASYNCMARK, then another unmarked async load.
# WAIT_ASYNCMARK(0) must wait for both loads (asynccnt(1), not asynccnt(0)).
#
# CHECK-LABEL: name: asynccnt_unmarked_load_above
# CHECK: GLOBAL_LOAD_ASYNC_TO_LDS_B32
# CHECK-NEXT: ASYNCMARK
# CHECK-NEXT: GLOBAL_LOAD_ASYNC_TO_LDS_B32
# CHECK-NEXT: WAIT_ASYNCMARK 0
# CHECK-NEXT: S_WAIT_ASYNCCNT 1
---
name: asynccnt_unmarked_load_above
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; Marked load
    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ASYNCMARK
    ; Unmarked load above the mark
    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 4, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt
    ; Should wait for both: asynccnt(1) not asynccnt(0)
    WAIT_ASYNCMARK 0
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
