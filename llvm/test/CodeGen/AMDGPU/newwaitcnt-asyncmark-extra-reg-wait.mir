# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s
#
# After WAIT_ASYNCMARK 0 drains VmCnt to 1 (waiting for $vgpr1), the register
# dependency on $vgpr7 (which is below $vgpr1 in VmCnt) should already be
# satisfied — no extra vmcnt wait should be emitted before V_MOV_B32.

---
name: test
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4, $m0
    ; CHECK-LABEL: name: test
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4, $m0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
    ; CHECK-NEXT: $vgpr7 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    ; CHECK-NEXT: GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ; CHECK-NEXT: $vgpr1 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    ; CHECK-NEXT: ASYNCMARK
    ; CHECK-NEXT: WAIT_ASYNCMARK 0
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    ; CHECK-NEXT: $vgpr3 = DS_READ_B32_gfx9 $vgpr4, 0, 0, implicit $exec
    ; CHECK-NEXT: $vgpr5 = V_MOV_B32_e32 killed $vgpr7, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr7 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    $vgpr1 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    ASYNCMARK
    WAIT_ASYNCMARK 0
    $vgpr3 = DS_READ_B32_gfx9 $vgpr4, 0, 0, implicit $exec
    $vgpr5 = V_MOV_B32_e32 killed $vgpr7, implicit $exec
    S_ENDPGM 0
...
