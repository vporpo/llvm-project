# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
#
# A VMEM load reads $vgpr0 as its address (XCnt USE) and defines $vgpr0
# (LoadCnt DEF). The subsequent V_MAX defines $vgpr0 — a WAR on the XCnt
# address. S_WAIT_LOADCNT 0 already guarantees the load (and its address reads)
# have completed, so S_WAIT_XCNT 0 must NOT be emitted.
#
---
name: loadcnt_implies_xcnt
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1
    ; CHECK-LABEL: name: loadcnt_implies_xcnt
    ; CHECK: liveins: $vgpr0, $sgpr0_sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: GLOBAL_PREFETCH_B8_SADDR undef $sgpr0_sgpr1, undef $vgpr0, 0, 8, implicit $exec
    ; CHECK-NEXT: V_NOP_e32 implicit $exec
    ; CHECK-NEXT: renamable $vgpr0 = GLOBAL_LOAD_DWORD_SADDR killed renamable $sgpr0_sgpr1, killed renamable $vgpr0, 0, 0, implicit $exec
    ; CHECK-NEXT: S_WAIT_LOADCNT 0
    ; CHECK-NEXT: renamable $vgpr0 = V_MAX_I32_e32 1, killed $vgpr0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    renamable $vgpr0 = GLOBAL_LOAD_DWORD_SADDR killed renamable $sgpr0_sgpr1, killed renamable $vgpr0, 0, 0, implicit $exec
    renamable $vgpr0 = V_MAX_I32_e32 1, killed $vgpr0, implicit $exec
    S_ENDPGM 0
...
