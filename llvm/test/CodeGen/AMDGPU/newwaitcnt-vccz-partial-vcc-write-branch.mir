# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On pre-GFX10 targets (!partialVCCWritesUpdateVCCZ(), e.g. gfx900) a partial
# write to VCC (writing only VCC_LO or VCC_HI) does NOT update the vccz bit. So
# before an instruction that reads vccz (here S_CBRANCH_VCCNZ) following such a
# partial write, vccz must be recomputed by writing vcc back to itself
# ("s_mov_b64 vcc, vcc"). Unlike the SI/CI VCCZ bug, no waitcnt is needed here -
# the issue is purely that the partial write left vccz stale.

---
name: partial_vcc_write_branch
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: partial_vcc_write_branch
  ; CHECK: $vcc_lo = S_MOV_B32 $sgpr0
  ; CHECK-NEXT: $vcc = S_MOV_B64 $vcc
  ; CHECK-NEXT: S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  bb.0:
    liveins: $sgpr0
    $vcc_lo = S_MOV_B32 $sgpr0
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    S_NOP 0
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0
...
