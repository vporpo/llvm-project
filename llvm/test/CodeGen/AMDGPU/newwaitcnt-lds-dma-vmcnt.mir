# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass="aa,si-insert-waitcnts" -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass="aa,amdgpu-new-insert-waitcnts" -o - %s | FileCheck %s

# 4 DMA ops write to two LDS arrays (2 each). A DS read from array 0 only
# needs the 2 aliasing DMAs to complete, so vmcnt(2) suffices.
# The "aa" pass provides scoped-noalias disambiguation.

# CHECK-LABEL: name: lds_dma_two_arrays
# CHECK:        S_WAITCNT {{.*}}Vmcnt_2
# CHECK-NEXT:   DS_READ_B32

--- |
  %lds.t = type { [64 x float], [64 x float] }
  @lds = internal addrspace(3) global %lds.t poison, align 16, !absolute_symbol !0

  define amdgpu_kernel void @lds_dma_two_arrays() {
    %gep.0 = getelementptr inbounds %lds.t, ptr addrspace(3) @lds, i32 0, i32 0, i32 0
    ret void
  }

  !0 = !{i32 0, i32 1}
  !1 = distinct !{!1}
  !2 = distinct !{!2, !1}
  !3 = !{!2}
  !4 = distinct !{!4, !1}
  !5 = !{!4}
...

---
name: lds_dma_two_arrays
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $vgpr0, $vgpr1, $vgpr2

    $m0 = S_MOV_B32 0
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $m0 :: (load (s32), addrspace 8), (store (s2048) into @lds, align 1, !alias.scope !3, !noalias !5, addrspace 3)
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, 0, implicit $exec, implicit $m0 :: (load (s32), addrspace 8), (store (s2048) into @lds, align 1, !alias.scope !3, !noalias !5, addrspace 3)
    $m0 = S_MOVK_I32 256
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $m0 :: (load (s32), addrspace 8), (store (s2048) into `ptr addrspace(3) getelementptr inbounds (%lds.t, ptr addrspace(3) @lds, i32 0, i32 1)`, align 1, !alias.scope !5, !noalias !3, addrspace 3)
    BUFFER_LOAD_DWORD_LDS_OFFEN $vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, 0, implicit $exec, implicit $m0 :: (load (s32), addrspace 8), (store (s2048) into `ptr addrspace(3) getelementptr inbounds (%lds.t, ptr addrspace(3) @lds, i32 0, i32 1)`, align 1, !alias.scope !5, !noalias !3, addrspace 3)
    renamable $vgpr2 = DS_READ_B32_gfx9 killed renamable $vgpr2, 0, 0, implicit $exec :: (load (s32) from %ir.gep.0, !alias.scope !3, !noalias !5, addrspace 3)
    S_ENDPGM 0
...
