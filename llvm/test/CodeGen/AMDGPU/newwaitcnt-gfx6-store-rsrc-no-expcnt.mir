# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On gfx6 the export counter (ExpCnt) only orders against a store reading its
# DATA source register(s): such a store does not decrement ExpCnt until it has
# read its data operand, so a "wait expcnt 0" (the S_WAITCNT instruction that
# waits until ExpCnt reaches 0) waits until that read has happened. The store's
# other inputs - the buffer resource descriptor (the SGPR quad describing the
# buffer) and the offset - are not ordered by ExpCnt. So only overwriting the
# data register needs a wait expcnt 0; overwriting the resource descriptor does
# not.
#
# Here BUFFER_STORE_DWORDX2_OFFSET stores data $vgpr0_vgpr1 using resource
# descriptor $sgpr0_sgpr1_sgpr2_sgpr3. The following S_ADD_U32 overwrites $sgpr0
# (part of the resource descriptor) - not the data source - so no wait expcnt 0
# belongs before it. The wait expcnt 0 is only needed before $vgpr0 is
# overwritten.

---
name: store_rsrc_overwrite_no_expcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $vgpr0, $vgpr1, $sgpr6
    ; CHECK-LABEL: name: store_rsrc_overwrite_no_expcnt
    ; CHECK: BUFFER_STORE_DWORDX2_OFFSET $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3
    ; CHECK-NEXT: $sgpr0 = S_ADD_U32
    ; CHECK-NEXT: S_WAITCNT {{.*}}Expcnt_0
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32
    BUFFER_STORE_DWORDX2_OFFSET $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    $sgpr0 = S_ADD_U32 $sgpr6, 12345, implicit-def $scc
    $vgpr0 = V_MOV_B32_e32 $sgpr0, implicit $exec
    S_ENDPGM 0
...
