# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# In this loop, the back-edge brings 2 additional VALU results (v0, v1)
# from the end of the loop body. Combined with the 4 VALUs at the loop top
# (v4, v5, v2, v3), there are 6 VALU results pending on VaVdst when
# FLAT_LOAD reads v4_v5. The correct VaVdst wait should account for the
# back-edge state.

# CHECK-LABEL: name: vavdst_backedge
# CHECK:      bb.1:
# CHECK:        V_ADD_CO_U32
# CHECK:        V_ADDC_U32
# CHECK:        V_ADD_CO_U32
# CHECK:        V_ADDC_U32
# CHECK:        S_WAITCNT_DEPCTR {{.*}}VaVdst_2
# CHECK-NEXT:   FLAT_LOAD_DWORDX4

---
name: vavdst_backedge
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $vgpr0_vgpr1, $vgpr2_vgpr3
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $vgpr0_vgpr1, $vgpr2_vgpr3
    renamable $vgpr4, renamable $vcc_lo = V_ADD_CO_U32_e64 -176, $vgpr2, 0, implicit $exec
    S_WAITCNT_DEPCTR .VaVcc_0
    renamable $vgpr5, dead $sgpr_null = V_ADDC_U32_e64 -1, $vgpr3, killed $vcc_lo, 0, implicit $exec
    renamable $vgpr2, renamable $vcc_lo = V_ADD_CO_U32_e64 killed $vgpr2, 16, 0, implicit $exec
    S_WAITCNT_DEPCTR .VaVcc_0
    renamable $vgpr3, dead $sgpr_null = V_ADDC_U32_e64 0, killed $vgpr3, killed $vcc_lo, 0, implicit $exec
    renamable $vgpr4_vgpr5_vgpr6_vgpr7 = FLAT_LOAD_DWORDX4 killed renamable $vgpr4_vgpr5, 0, 0, implicit $exec, implicit $flat_scr :: (load (s128))
    renamable $sgpr0 = S_ADD_I32 killed renamable $sgpr0, -1, implicit-def dead $scc
    S_CMP_LG_U32 renamable $sgpr0, 0, implicit-def $scc
    S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    FLAT_STORE_DWORDX4 renamable $vgpr0_vgpr1, killed renamable $vgpr4_vgpr5_vgpr6_vgpr7, 0, 0, implicit $exec, implicit $flat_scr :: (store (s128))
    renamable $vgpr0, renamable $vcc_lo = V_ADD_CO_U32_e64 killed $vgpr0, 16, 0, implicit $exec
    S_WAITCNT_DEPCTR .VaVcc_0
    renamable $vgpr1, dead $sgpr_null = V_ADDC_U32_e64 0, killed $vgpr1, killed $vcc_lo, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
