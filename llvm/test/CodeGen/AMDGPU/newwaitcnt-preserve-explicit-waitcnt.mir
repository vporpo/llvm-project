# RUN: llc -mtriple=amdgcn -mcpu=tahiti -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=tahiti -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# An explicit (hard) S_WAITCNT - e.g. from an llvm.amdgcn.s.waitcnt intrinsic -
# must be preserved verbatim; the pass must not drop a "redundant" counter from
# it. Only soft waits inserted by an earlier pass are simplified. Here the user's
# S_WAITCNT 49279 requests lgkmcnt(0) (vmcnt/expcnt are at their no-wait max). The
# IMAGE_STORE's read of the IMAGE_LOAD result independently needs vmcnt(0), so the
# result is vmcnt(0) lgkmcnt(0): the user's lgkmcnt is kept even though nothing is
# pending on it.

---
name: preserve_explicit_waitcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7
    ; CHECK: renamable $vgpr1_vgpr2_vgpr3_vgpr4 = IMAGE_LOAD_V4_V1
    ; CHECK: S_WAITCNT {{.*}}Vmcnt_0{{.*}}Lgkmcnt_0
    ; CHECK-NEXT: IMAGE_STORE_V4_V1
    renamable $vgpr1_vgpr2_vgpr3_vgpr4 = IMAGE_LOAD_V4_V1 renamable $vgpr0, renamable $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 15, -1, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable load (s128), addrspace 8)
    renamable $vgpr0 = V_LSHLREV_B32_e32 1, killed $vgpr0, implicit $exec
    S_WAITCNT 49279
    IMAGE_STORE_V4_V1 killed renamable $vgpr1_vgpr2_vgpr3_vgpr4, killed renamable $vgpr0, killed renamable $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 15, -1, 0, 0, 0, 0, 0, 0, implicit $exec :: (dereferenceable store (s128), addrspace 8)
    S_ENDPGM 0
...
