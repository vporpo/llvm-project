# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1030 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1030 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# FLAT_LOADs pending on VmCnt, then scratch BUFFER_LOADs also on VmCnt,
# then FLAT_STOREs consuming the buffer load results. The FLAT_STOREs
# should get precise vmcnt waits for the buffer loads, not vmcnt(0).

# CHECK-LABEL: name: scratch_flat
# CHECK:        BUFFER_LOAD_DWORD
# CHECK:        BUFFER_LOAD_DWORD
# CHECK:        BUFFER_LOAD_DWORD
# CHECK:        BUFFER_LOAD_DWORD
# CHECK:        S_WAITCNT {{.*}}Vmcnt_3
# CHECK-NEXT:   FLAT_STORE_BYTE_D16_HI

---
name: scratch_flat
tracksRegLiveness: true
stack:
  - { id: 0, type: default, size: 16, alignment: 16 }
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, $vgpr0_vgpr1, $vgpr6_vgpr7, $vgpr10, $vgpr11

    ; Pending FLAT loads on VmCnt from an earlier memcpy.
    renamable $vgpr20_vgpr21_vgpr22_vgpr23 = FLAT_LOAD_DWORDX4 renamable $vgpr6_vgpr7, 0, 0, implicit $exec, implicit $flat_scr :: (load (s128) from `ptr undef`)

    ; Spill to scratch and reload — BUFFER_STORE uses VsCnt, BUFFER_LOAD uses VmCnt.
    BUFFER_STORE_DWORD_OFFSET killed $vgpr10, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 8, 0, 0, implicit $exec :: (store (s32) into %stack.0 + 8, align 8, addrspace 5)
    BUFFER_STORE_DWORD_OFFSET killed $vgpr11, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 12, 0, 0, implicit $exec :: (store (s32) into %stack.0 + 12, addrspace 5)
    renamable $vgpr2 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 12, 0, 0, implicit $exec :: (load (s32) from %stack.0 + 12, addrspace 5)
    renamable $vgpr3 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 8, 0, 0, implicit $exec :: (load (s32) from %stack.0 + 8, align 8, addrspace 5)
    renamable $vgpr4 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 4, 0, 0, implicit $exec :: (load (s32) from %stack.0 + 4, addrspace 5)
    renamable $vgpr5 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 0, 0, 0, implicit $exec :: (load (s32) from %stack.0, align 16, addrspace 5)

    ; FLAT stores consume the buffer load results.
    FLAT_STORE_BYTE_D16_HI $vgpr0_vgpr1, killed $vgpr2, 0, 0, implicit $exec, implicit $flat_scr :: (store (s8))
    FLAT_STORE_BYTE_D16_HI $vgpr0_vgpr1, killed $vgpr3, 2, 0, implicit $exec, implicit $flat_scr :: (store (s8))
    FLAT_STORE_BYTE_D16_HI $vgpr0_vgpr1, killed $vgpr4, 4, 0, implicit $exec, implicit $flat_scr :: (store (s8))
    FLAT_STORE_BYTE_D16_HI $vgpr0_vgpr1, killed $vgpr5, 6, 0, implicit $exec, implicit $flat_scr :: (store (s8))
    S_ENDPGM 0
...
