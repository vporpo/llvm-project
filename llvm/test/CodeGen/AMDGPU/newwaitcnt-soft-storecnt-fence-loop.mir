# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# The memory legalizer inserts a soft S_WAIT_STORECNT 0 before a seq_cst atomic
# (here a cmpxchg loop body) to order it after prior stores. In a non-entry
# function those stores may belong to the CALLER, whose StoreCnt state is unknown
# on entry. The fence must be kept even though no store is visible in this
# function and even though it sits in a loop body reached from the entry edge.
# The incoming StoreCnt is conservatively assumed non-zero, so the fence is not
# redundant. (This is the loop-body counterpart of the entry-block case in
# newwaitcnt-soft-storecnt-fence-non-entry.mir.)

---
name: cmpswap_loop_storecnt_fence
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cmpswap_loop_storecnt_fence
  ; CHECK: S_WAIT_STORECNT 0
  ; CHECK-NEXT: renamable $vgpr4_vgpr5 = GLOBAL_ATOMIC_CMPSWAP_X2_RTN
  bb.0:
    successors: %bb.1
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $sgpr0
    S_WAIT_STORECNT_soft 0
    renamable $vgpr4_vgpr5 = GLOBAL_ATOMIC_CMPSWAP_X2_RTN renamable $vgpr0_vgpr1, renamable $vgpr4_vgpr5_vgpr6_vgpr7, 0, 17, implicit $exec :: (load store syncscope("agent") seq_cst seq_cst (s64), addrspace 1)
    S_WAIT_LOADCNT_soft 0
    GLOBAL_INV 16, implicit $exec
    S_CBRANCH_EXECNZ %bb.1, implicit $exec

  bb.2:
    S_ENDPGM 0
...
