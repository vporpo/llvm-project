# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -amdgpu-expert-scheduling-mode=1 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# In expert scheduling mode 2, VALU→VALU dependencies within the same category
# are handled by the hardware pipeline (in-order completion). The pass must NOT
# insert S_WAITCNT_DEPCTR VaVdst_0 between two VALUs. The VaVdst wait is only
# needed before leaving expert mode (before return / before call). The old pass
# defers the wait to the end; the new pass must match.

# CHECK-LABEL: name: esm2_valu_dep
# CHECK:        V_ADD_F32_e32
# CHECK-NOT:    S_WAITCNT_DEPCTR
# CHECK-NEXT:   V_MUL_F32_e32
# CHECK-NEXT:   S_WAITCNT_DEPCTR
# CHECK-NEXT:   S_SETREG_IMM32_B32 0
# CHECK-NEXT:   S_SETPC_B64_return

---
name: esm2_valu_dep
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr30_sgpr31
    renamable $vgpr0 = V_ADD_F32_e32 killed $vgpr0, $vgpr1, implicit $mode, implicit $exec
    renamable $vgpr0 = V_MUL_F32_e32 killed $vgpr0, $vgpr1, implicit $mode, implicit $exec
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit killed $vgpr0
...
