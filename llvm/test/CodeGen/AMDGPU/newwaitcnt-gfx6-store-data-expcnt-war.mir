# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=verde -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# On pre-SEA_ISLANDS targets (gfx6, e.g. verde) the export counter (ExpCnt) is
# what orders against a store reading its data source register(s): such a store
# does not decrement ExpCnt until it has read its data operand. So overwriting a
# store's data register needs a "wait expcnt 0" (the S_WAITCNT instruction that
# waits until ExpCnt reaches 0) first, otherwise the store could read the new
# value instead of the old one (a write-after-read hazard).
#
# Here BUFFER_STORE_DWORD_OFFSET reads $vgpr0 as data, and the following
# V_MOV_B32 overwrites $vgpr0, so a wait expcnt 0 is required between them.

---
name: store_data_war_expcnt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3
    ; CHECK-LABEL: name: store_data_war_expcnt
    ; CHECK: BUFFER_STORE_DWORD_OFFSET $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3
    ; CHECK-NEXT: S_WAITCNT {{.*}}Expcnt_0
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    BUFFER_STORE_DWORD_OFFSET $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    S_ENDPGM 0
...
