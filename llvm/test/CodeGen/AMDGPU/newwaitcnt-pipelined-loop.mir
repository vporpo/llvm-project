# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=OLD
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s --check-prefix=NEW

# Test software pipelined loop with multiple loads.
# At the loop header, we use v15 which was loaded in the prior iteration.
# The wait should be vmcnt(1), not vmcnt(0), since only the LDS load
# from the current iteration should still be pending.

---
name: pipelined_loop_test
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $m0

    ; Prolog: load v8, v9, then LDS
    $vgpr8 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr9 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec

    ; Wait for v8, v9 before copying to loop vars
    S_WAITCNT 3954
    $vgpr13 = V_MOV_B32_e32 $vgpr8, implicit $exec
    S_WAITCNT 3953
    $vgpr15 = V_MOV_B32_e32 $vgpr9, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    ; Loop header - 1 LDS load pending from prolog
    successors: %bb.2, %bb.1
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr13, $vgpr15, $m0

    ; OLD: bb.1:
    ; OLD: S_WAITCNT .Vmcnt_1
    ; OLD-NEXT: $vgpr12 = V_MOV_B32_e32 killed $vgpr15

    ; NEW: bb.1:
    ; NEW: S_WAITCNT .Vmcnt_1
    ; NEW-NEXT: $vgpr12 = V_MOV_B32_e32 killed $vgpr15

    ; Use v15 from prior load (prolog or prior iteration)
    $vgpr12 = V_MOV_B32_e32 killed $vgpr15, implicit $exec
    $vgpr11 = V_MOV_B32_e32 killed $vgpr13, implicit $exec

    ; Load new values for next iteration
    $vgpr13 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr15 = GLOBAL_LOAD_DWORD $vgpr2_vgpr3, 0, 0, implicit $exec
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec

    S_CBRANCH_EXECNZ %bb.1, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    liveins: $vgpr11, $vgpr12

    S_WAITCNT 0
    S_ENDPGM 0
...
