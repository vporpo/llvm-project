# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX9
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX9
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX10
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX10
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX11
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX11
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s --check-prefix=GFX12

# Test Counter::isNonZeroWaitLegal() patterns for vmcnt/loadcnt.
# Position-based waits (cnt > 0) indicate in-order completion is legal.
# cnt 0 indicates out-of-order (must wait for all).
#
# The result of isNonZeroWaitLegal(SrcMI, DstMI) depends on:
#   1. The type of SrcMI and DstMI (VMEM-only, FLAT, DS, etc.)
#   2. The VmemType of SrcMI and DstMI (NOSAMPLER, SAMPLER, BVH)
#   3. The contents of the Counter (other pending instructions)
#   4. Target features (hasFlatLgkmVMemCountInOrder, etc.)
#
# ============================================================================
# Test Summary Table
# ============================================================================
#
# Section 1: VMEM-only instructions (GLOBAL, SCRATCH, BUFFER, IMAGE_LOAD)
# ------------------------------------------------------------------------
# | Test Name                    | SrcMI        | DstMI        | Pending   | Expected (GFX9-11) | Expected (GFX12) |
# |------------------------------|--------------|--------------|-----------|--------------------| -----------------|
# | global_global_waw            | GLOBAL       | GLOBAL       | (none)    | vmcnt 1            | loadcnt 1        |
# | scratch_scratch_waw          | SCRATCH      | SCRATCH      | (none)    | vmcnt 1            | loadcnt 1        |
# | global_scratch_waw           | GLOBAL       | SCRATCH      | (none)    | vmcnt 1            | loadcnt 1        |
# | buffer_buffer_waw            | BUFFER       | BUFFER       | (none)    | vmcnt 1            | loadcnt 1        |
# | image_load_image_load_waw    | IMAGE_LOAD   | IMAGE_LOAD   | (none)    | vmcnt 1            | loadcnt 1        |
# | global_image_load_waw        | GLOBAL       | IMAGE_LOAD   | (none)    | vmcnt 1            | loadcnt 1        |
#
# Section 2: Mixed VmemType (NOSAMPLER vs SAMPLER)
# ------------------------------------------------------------------------
# | Test Name                    | SrcMI        | DstMI        | Pending   | Expected (GFX9-11) | Expected (GFX12) |
# |------------------------------|--------------|--------------|-----------|--------------------| -----------------|
# | image_load_image_sample_waw  | IMAGE_LOAD   | IMAGE_SAMPLE | (none)    | vmcnt 1            | loadcnt 0        |
# | global_image_sample_waw      | GLOBAL       | IMAGE_SAMPLE | (none)    | vmcnt 1            | loadcnt 0        |
#
# Section 3: FLAT instructions
# ------------------------------------------------------------------------
# | Test Name                    | SrcMI        | DstMI        | Pending   | Expected (GFX9)    | Expected (GFX10+)| Expected (GFX12) |
# |------------------------------|--------------|--------------|-----------|--------------------| -----------------|------------------|
# | flat_flat_waw                | FLAT         | FLAT         | (none)    | vmcnt 0, lgkmcnt 0 | vmcnt 1,lgkmcnt 1| loadcnt 1,dscnt 1|
# | flat_global_waw              | FLAT         | GLOBAL       | (none)    | lgkmcnt 0          | lgkmcnt 0        | loadcnt 0,dscnt 0|
# | global_flat_waw              | GLOBAL       | FLAT         | (none)    | vmcnt 0            | vmcnt 0          | loadcnt 0        |
#
# Section 4: VMEM → VALU (RAW dependency, non-memory consumer)
# ------------------------------------------------------------------------
# | Test Name                    | SrcMI        | DstMI        | Pending   | Expected (GFX9-11) | Expected (GFX12) |
# |------------------------------|--------------|--------------|-----------|--------------------| -----------------|
# | global_valu_raw              | GLOBAL       | VALU         | (none)    | vmcnt 0            | loadcnt 0        |
# | flat_valu_raw                | FLAT         | VALU         | (none)    | vmcnt 0, lgkmcnt 0 | loadcnt 0,dscnt 0|
#
# Section 5: DS instructions (lgkmcnt/dscnt)
# ------------------------------------------------------------------------
# | Test Name                    | SrcMI        | DstMI        | Pending   | Expected (GFX9-11) | Expected (GFX12) |
# |------------------------------|--------------|--------------|-----------|--------------------| -----------------|
# | ds_read_ds_read_waw          | DS_READ      | DS_READ      | (none)    | lgkmcnt 1          | dscnt 1          |
# | ds_read_ds_write_war         | DS_READ      | DS_WRITE     | (none)    | lgkmcnt 1          | dscnt 1          |
#
# ============================================================================
#
# Tests with pending instructions in-between A and B are in:
#   newwaitcnt-is-non-zero-wait-legal-with-pending-in-between.mir

---
# GLOBAL → GLOBAL (same VmemType: NOSAMPLER)
# Expected: in-order, position-based wait
name: global_global_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: global_global_waw
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_global_waw
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: global_global_waw
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: global_global_waw
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec
...

---
# SCRATCH → SCRATCH (same VmemType: NOSAMPLER)
# Expected: in-order, position-based wait
name: scratch_scratch_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; GFX9-LABEL: name: scratch_scratch_waw
    ; GFX9: SCRATCH_LOAD_DWORD
    ; GFX9-NEXT: SCRATCH_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: scratch_scratch_waw
    ; GFX10: SCRATCH_LOAD_DWORD
    ; GFX10-NEXT: SCRATCH_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: scratch_scratch_waw
    ; GFX11: SCRATCH_LOAD_DWORD
    ; GFX11-NEXT: SCRATCH_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: scratch_scratch_waw
    ; GFX12: SCRATCH_LOAD_DWORD
    ; GFX12-NEXT: SCRATCH_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = SCRATCH_LOAD_DWORD $vgpr0, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr3 = SCRATCH_LOAD_DWORD $vgpr0, 4, 0, implicit $exec, implicit $flat_scr
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec
...

---
# GLOBAL → SCRATCH (both VMEM-only, same VmemType: NOSAMPLER)
# Expected: in-order
name: global_scratch_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr4
    ; GFX9-LABEL: name: global_scratch_waw
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: SCRATCH_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_scratch_waw
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: SCRATCH_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: global_scratch_waw
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: SCRATCH_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: global_scratch_waw
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: SCRATCH_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr3 = SCRATCH_LOAD_DWORD $vgpr4, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec
...

---
# GLOBAL → VALU (non-memory consumer, RAW)
# Expected: vmcnt 0 (wait for all since it's a RAW, not WAW)
name: global_valu_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: global_valu_raw
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX9-NEXT: $vgpr2 = V_ADD
    ;
    ; GFX10-LABEL: name: global_valu_raw
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX10-NEXT: $vgpr2 = V_ADD
    ;
    ; GFX11-LABEL: name: global_valu_raw
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX11-NEXT: $vgpr2 = V_ADD
    ;
    ; GFX12-LABEL: name: global_valu_raw
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 0
    ; GFX12-NEXT: $vgpr2 = V_ADD
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
    $vgpr2 = V_ADD_U32_e32 $vgpr2, $vgpr3, implicit $exec
...

---
# FLAT → FLAT (pure FLAT, WAW)
# gfx9: NOT in-order (vmcnt 0, lgkmcnt 0)
# gfx10+: in-order (vmcnt 1, lgkmcnt 1)
name: flat_flat_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: flat_flat_waw
    ; GFX9: FLAT_LOAD_DWORD
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX9-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: flat_flat_waw
    ; GFX10: FLAT_LOAD_DWORD
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX10-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: flat_flat_waw
    ; GFX11: FLAT_LOAD_DWORD
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1_Lgkmcnt_1
    ; GFX11-NEXT: $vgpr2 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: flat_flat_waw
    ; GFX12: FLAT_LOAD_DWORD
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_1_Dscnt_1
    ; GFX12-NEXT: $vgpr2 = V_MOV_B32
    $vgpr2 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr
    $vgpr2 = V_MOV_B32_e32 $vgpr2, implicit $exec
...

---
# FLAT → VALU (non-memory consumer, RAW)
# Expected: wait for all (vmcnt 0, lgkmcnt 0)
name: flat_valu_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: flat_valu_raw
    ; GFX9: FLAT_LOAD_DWORD
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX9-NEXT: $vgpr4 = V_ADD
    ;
    ; GFX10-LABEL: name: flat_valu_raw
    ; GFX10: FLAT_LOAD_DWORD
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX10-NEXT: $vgpr4 = V_ADD
    ;
    ; GFX11-LABEL: name: flat_valu_raw
    ; GFX11: FLAT_LOAD_DWORD
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_0_Lgkmcnt_0
    ; GFX11-NEXT: $vgpr4 = V_ADD
    ;
    ; GFX12-LABEL: name: flat_valu_raw
    ; GFX12: FLAT_LOAD_DWORD
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; GFX12-NEXT: $vgpr4 = V_ADD
    $vgpr2 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr
    $vgpr4 = V_ADD_U32_e32 $vgpr2, $vgpr3, implicit $exec
...

---
# FLAT → GLOBAL (pure FLAT then segment-specific, WAW)
# Expected: only lgkmcnt 0 (vmcnt in-order for FLAT->GLOBAL)
name: flat_global_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: flat_global_waw
    ; GFX9: FLAT_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX9-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX10-LABEL: name: flat_global_waw
    ; GFX10: FLAT_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX10-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX11-LABEL: name: flat_global_waw
    ; GFX11: FLAT_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GFX11-NEXT: GLOBAL_LOAD_DWORD
    ;
    ; GFX12-LABEL: name: flat_global_waw
    ; GFX12: FLAT_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; GFX12-NEXT: GLOBAL_LOAD_DWORD
    $vgpr2 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec
...

---
# GLOBAL → FLAT (segment-specific then pure FLAT, WAW)
# Expected: vmcnt 0 (FLAT can access LDS, not in-order)
name: global_flat_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX9-LABEL: name: global_flat_waw
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX9-NEXT: FLAT_LOAD_DWORD
    ;
    ; GFX10-LABEL: name: global_flat_waw
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX10-NEXT: FLAT_LOAD_DWORD
    ;
    ; GFX11-LABEL: name: global_flat_waw
    ; GFX11: GLOBAL_LOAD_DWORD
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_0
    ; GFX11-NEXT: FLAT_LOAD_DWORD
    ;
    ; GFX12-LABEL: name: global_flat_waw
    ; GFX12: GLOBAL_LOAD_DWORD
    ; GFX12-NEXT: S_WAIT_LOADCNT 0
    ; GFX12-NEXT: FLAT_LOAD_DWORD
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $vgpr2 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr
...

---
# IMAGE_LOAD → IMAGE_LOAD (same VmemType: NOSAMPLER)
# Expected: in-order
name: image_load_image_load_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7
    ; GFX9-LABEL: name: image_load_image_load_waw
    ; GFX9: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: image_load_image_load_waw
    ; GFX10: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: image_load_image_load_waw
    ; GFX11: IMAGE_LOAD_V1_V4
    ; GFX11-NEXT: IMAGE_LOAD_V1_V4
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: image_load_image_load_waw
    ; GFX12: IMAGE_LOAD_V1_V4
    ; GFX12-NEXT: IMAGE_LOAD_V1_V4
    ; GFX12-NEXT: S_WAIT_LOADCNT 1
    ; GFX12-NEXT: $vgpr4 = V_MOV_B32
    $vgpr4 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))
    $vgpr5 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))
    $vgpr4 = V_MOV_B32_e32 $vgpr4, implicit $exec
...

---
# IMAGE_LOAD → IMAGE_SAMPLE (different VmemType: NOSAMPLER vs SAMPLER)
# gfx9/gfx10/gfx11: position-based (vmcnt 1) - different VmemTypes still in-order for pre-gfx12
# gfx12: NOT in-order (loadcnt 0) - different counters (loadcnt vs samplecnt)
name: image_load_image_sample_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX9-LABEL: name: image_load_image_sample_waw
    ; GFX9: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: image_load_image_sample_waw
    ; GFX10: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX10-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX11-LABEL: name: image_load_image_sample_waw
    ; GFX11: IMAGE_LOAD_V1_V4
    ; GFX11-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX11-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX11-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX12-LABEL: name: image_load_image_sample_waw
    ; GFX12: IMAGE_LOAD_V1_V4
    ; GFX12-NEXT: IMAGE_SAMPLE_V1_V2
    ; GFX12-NEXT: S_WAIT_LOADCNT 0
    ; GFX12-NEXT: $vgpr4 = V_MOV_B32
    $vgpr4 = IMAGE_LOAD_V1_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))
    $vgpr5 = IMAGE_SAMPLE_V1_V2 $vgpr0_vgpr1, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, 1, 0, 0, 0, 0, 0, 0, 0, implicit $exec :: (load (s32))
    $vgpr4 = V_MOV_B32_e32 $vgpr4, implicit $exec
...

---
# GLOBAL → IMAGE_LOAD (both NOSAMPLER)
# Expected: in-order
name: global_image_load_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5_sgpr6_sgpr7
    ; GFX9-LABEL: name: global_image_load_waw
    ; GFX9: GLOBAL_LOAD_DWORD
    ; GFX9-NEXT: IMAGE_LOAD_V1_V4
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_1
    ; GFX9-NEXT: $vgpr4 = V_MOV_B32
    ;
    ; GFX10-LABEL: name: global_image_load_waw
    ; GFX10: GLOBAL_LOAD_DWORD
    ; GFX10-NEXT: IMAGE_LOAD_V1_V4
    ; GFX10-NEXT: S_WAITCNT .Vmcnt_1
