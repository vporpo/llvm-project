# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Test that the dataflow analysis converges when a store in a loop is
# re-tracked on each iteration. Without proper handling, the store instruction
# would move to a new index on each iteration, causing infinite dataflow loop.

# CHECK-LABEL: dataflow_convergence
# CHECK-LABEL: bb.0:
# CHECK: BUFFER_LOAD_FORMAT_X_IDXEN
# CHECK-LABEL: bb.1:
# CHECK-NOT: S_WAITCNT
# CHECK-LABEL: bb.2:
---
name: dataflow_convergence
body: |
  bb.0:
    successors: %bb.1

    $vgpr0 = BUFFER_LOAD_FORMAT_X_IDXEN killed $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    ; Store does not use $vgpr0, so no wait needed for the load.
    BUFFER_STORE_DWORD_OFFEN_exact $vgpr5, $vgpr6, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    $vgpr1 = V_ADD_U32_e32 $vgpr2, $vgpr2, implicit $exec
    S_CMP_LG_U32 killed $sgpr3, $sgpr4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit killed $scc
    S_BRANCH %bb.2

  bb.2:
    ; Use the loaded value here, wait should be in this block.
    $vgpr1 = V_ADD_U32_e32 $vgpr0, $vgpr0, implicit $exec
    S_ENDPGM 0
...
