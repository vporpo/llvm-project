# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Two sequential loops, each loading a different VGPR. Only the last write to
# each register matters (earlier iterations are overwritten), so at bb.2 exactly
# 2 loads are relevant. vmcnt(1) is sufficient for the first store (v0).
# The new pass loses precision through dataflow merge at the backedge.

# CHECK-LABEL: name: two_loops
# CHECK:      bb.2:
# CHECK:      S_WAITCNT .Vmcnt_1
# CHECK-NEXT: GLOBAL_STORE_DWORD {{.*}} $vgpr0

---
name: two_loops
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
body: |
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $vgpr4_vgpr5, $vgpr6_vgpr7, $sgpr4

    renamable $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    S_CMP_LG_U32 $sgpr4, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.0, implicit $scc

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr4_vgpr5, $vgpr6_vgpr7, $sgpr4

    renamable $vgpr1 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
    S_CMP_LG_U32 $sgpr4, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    liveins: $vgpr0, $vgpr1, $vgpr4_vgpr5, $vgpr6_vgpr7
    GLOBAL_STORE_DWORD killed renamable $vgpr4_vgpr5, killed renamable $vgpr0, 0, 0, implicit $exec
    GLOBAL_STORE_DWORD killed renamable $vgpr6_vgpr7, killed renamable $vgpr1, 0, 0, implicit $exec
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
