# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# Entry block waits should NOT have a debug location.
# Dependency waits SHOULD have a debug location matching the consumer.

# CHECK-LABEL: name: entry_wait_no_debugloc
# CHECK:      S_WAITCNT
# CHECK-NOT:  debug-location
# CHECK:      V_MOV_B32
# CHECK:      FLAT_STORE_DWORD
# CHECK:      S_WAITCNT {{.*}}, debug-location ![[LOC:[0-9]+]]
# CHECK-NEXT: S_SETPC_B64_return {{.*}}, debug-location ![[LOC]]

--- |
  define void @entry_wait_no_debugloc(ptr %p) !dbg !3 {
    store i32 1, ptr %p, !dbg !5
    ret void, !dbg !6
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, isOptimized: false, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/tmp")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "entry_wait_no_debugloc", scope: !1, file: !1, line: 1, type: !4, unit: !0)
  !4 = !DISubroutineType(types: !{})
  !5 = !DILocation(line: 2, column: 3, scope: !3)
  !6 = !DILocation(line: 3, column: 1, scope: !3)
...
---
name: entry_wait_no_debugloc
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
body: |
  bb.0:
    liveins: $sgpr30_sgpr31, $vgpr0_vgpr1, $vgpr2

    renamable $vgpr2 = V_MOV_B32_e32 1, implicit $exec, debug-location !5
    FLAT_STORE_DWORD renamable $vgpr0_vgpr1, killed renamable $vgpr2, 0, 0, implicit $exec, implicit $flat_scr, debug-location !5 :: (store (s32))
    S_SETPC_B64_return undef $sgpr30_sgpr31, debug-location !6
...
