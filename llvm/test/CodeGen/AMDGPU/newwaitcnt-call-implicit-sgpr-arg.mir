# RUN: llc -mtriple=amdgcn--amdpal -mcpu=gfx900 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn--amdpal -mcpu=gfx900 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# A call's implicit SGPR operands are its inreg arguments. The callee waits for
# their readiness itself via the waits at its function entry, so the caller must
# not emit a redundant lgkmcnt wait before the call for an SMEM load that
# produces an inreg argument. Only the call-target address register needs a wait.

# CHECK-LABEL: name: call_with_sgpr_arg
# CHECK:        S_LOAD_DWORDX2_IMM
# CHECK-NOT:    S_WAITCNT
# CHECK-NEXT:   SI_CALL

---
name: call_with_sgpr_arg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5, $sgpr30_sgpr31, $sgpr34_sgpr35
    renamable $sgpr4_sgpr5 = S_LOAD_DWORDX2_IMM renamable $sgpr34_sgpr35, 0, 0 :: (dereferenceable invariant load (s64), addrspace 4)
    dead $sgpr30_sgpr31 = SI_CALL killed renamable $sgpr34_sgpr35, 0, csr_amdgpu, implicit killed $sgpr4_sgpr5
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
