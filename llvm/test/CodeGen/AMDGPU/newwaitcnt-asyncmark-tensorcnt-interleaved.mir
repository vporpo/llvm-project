    ; CHECK-NEXT: ASYNCMARK
    ; CHECK-NEXT: TENSOR_LOAD_TO_LDS_d2 $sgpr28_sgpr29_sgpr30_sgpr31, $sgpr20_sgpr21_sgpr22_sgpr23_sgpr24_sgpr25_sgpr26_sgpr27, 0, 0, implicit-def dead $tensorcnt, implicit $exec, implicit $tensorcnt
    ; CHECK-NEXT: ASYNCMARK
