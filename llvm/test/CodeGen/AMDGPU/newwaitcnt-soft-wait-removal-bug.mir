# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -run-pass=amdgpu-new-insert-waitcnts %s -o - | FileCheck %s

# Test that soft waits for fence semantics are correctly handled when there
# are pending SMEM operations.
#
# The memory legalizer inserts soft waits before GLOBAL_WB and atomics for
# seq_cst ordering. When there are pending SMEM loads (KmCnt) but no pending
# VMEM loads (LoadCnt) or stores (StoreCnt), the pass should still keep the
# soft waits for LoadCnt and StoreCnt because they enforce memory ordering.
#
# GLOBAL_WB increments StoreCnt, so the S_WAIT_STORECNT_soft after GLOBAL_WB
# must be promoted to S_WAIT_STORECNT (not removed or replaced with another
# counter wait).

# CHECK-LABEL: name: smem_load_then_atomic
# CHECK: dead $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM
# CHECK-NEXT: S_WAIT_KMCNT 0
# CHECK-NEXT: $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM
# CHECK: GLOBAL_WB
# Both passes emit S_WAIT_STORECNT 0 and S_WAIT_KMCNT 0 (order may differ).
# CHECK-DAG: S_WAIT_STORECNT 0
# CHECK-DAG: S_WAIT_KMCNT 0
# CHECK: GLOBAL_ATOMIC_ADD_SADDR

---
name: smem_load_then_atomic
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5

    ; Two SMEM loads - increments KmCnt (but NOT LoadCnt or StoreCnt)
    ; This matches the pattern from the original failing test
    dead $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM $sgpr4_sgpr5, 0, 32
    $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM killed $sgpr4_sgpr5, 0, 32
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    $vgpr1 = V_MOV_B32_e32 1, implicit $exec

    ; Fence sequence for seq_cst atomic
    ; LoadCnt and StoreCnt are empty but waits must be preserved for ordering
    S_WAIT_LOADCNT_soft 0
    S_WAIT_STORECNT_soft 0
    GLOBAL_WB 24, implicit $exec
    S_WAIT_LOADCNT_soft 0
    S_WAIT_STORECNT_soft 0
    S_WAIT_DSCNT_soft 0
    S_WAIT_XCNT_soft 0
    GLOBAL_ATOMIC_ADD_SADDR killed $vgpr0, killed $vgpr1, killed $sgpr0_sgpr1, 0, 24, implicit $exec
    S_WAIT_STORECNT_soft 0
    GLOBAL_INV 24, implicit $exec
    S_WAIT_LOADCNT_soft 0
    S_ENDPGM 0
...
