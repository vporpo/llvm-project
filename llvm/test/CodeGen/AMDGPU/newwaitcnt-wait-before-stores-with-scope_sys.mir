# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck -check-prefix=OLD %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck -check-prefix=NEW %s

# Verify that a system-scope store (scope:SCOPE_SYS / imm 24) gets a
# S_WAIT_STORECNT 0 after it to ensure all writes reach system scope before
# any subsequent instruction that may observe them.
#
# The buffer_store (intrinsic_store_system_scope) needs no extra wait because
# the store itself handles ordering. The global_store (generic_store_volatile)
# needs S_WAIT_STORECNT 0.
#
# OLD-LABEL: name: intrinsic_store_system_scope
# OLD:       BUFFER_STORE_DWORD_VBUFFER_BOTHEN_exact
# OLD-NOT:   S_WAIT_STORECNT
# OLD:       S_ENDPGM
#
# OLD-LABEL: name: generic_store_volatile
# OLD:       GLOBAL_STORE_DWORD
# OLD-NEXT:  S_WAIT_STORECNT 0
#
# NEW-LABEL: name: intrinsic_store_system_scope
# NEW:       BUFFER_STORE_DWORD_VBUFFER_BOTHEN_exact
# NEW-NOT:   S_WAIT_STORECNT
# NEW:       S_ENDPGM
#
# NEW-LABEL: name: generic_store_volatile
# NEW:       GLOBAL_STORE_DWORD
# NEW-NEXT:  S_WAIT_STORECNT 0

--- |
  target triple = "amdgcn"
  define amdgpu_ps void @intrinsic_store_system_scope() { unreachable }
  define amdgpu_ps void @generic_store_volatile() { unreachable }
...
---
name:            intrinsic_store_system_scope
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2, $sgpr3, $sgpr4, $vgpr0, $vgpr1, $vgpr2

    BUFFER_STORE_DWORD_VBUFFER_BOTHEN_exact killed renamable $vgpr0, killed renamable $vgpr1_vgpr2, killed renamable $sgpr0_sgpr1_sgpr2_sgpr3, killed renamable $sgpr4, 0, 24, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
    S_ENDPGM 0
...
---
name:            generic_store_volatile
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    GLOBAL_STORE_DWORD killed renamable $vgpr1_vgpr2, killed renamable $vgpr0, 0, 24, implicit $exec :: (volatile store (s32) into `ptr addrspace(1) null`, addrspace 1)
    S_WAIT_STORECNT 0
    S_ENDPGM 0
...
