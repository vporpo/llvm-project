# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-new-insert-waitcnts -o - %s | FileCheck %s

# A cache-invalidate (GLOBAL_INV) is tracked on LoadCnt, but it produces no
# result a caller consumes. So it must not force a LoadCnt wait before a return:
# here the return only needs $vgpr0 from the atomic, which the soft loadcnt wait
# before GLOBAL_INV already drained. The only S_WAIT_LOADCNT 0 should be the one
# before GLOBAL_INV (protecting the atomic result); no second wait is needed
# before S_SETPC, since the pending GLOBAL_INV is not a real dependency.

---
name: global_inv_before_return
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: global_inv_before_return
    ; CHECK: renamable $vgpr0 = GLOBAL_ATOMIC_ADD_RTN
    ; CHECK-NEXT: S_WAIT_LOADCNT 0
    ; CHECK-NEXT: GLOBAL_INV 24, implicit $exec
    ; CHECK-NEXT: S_SETPC_B64_return undef $sgpr30_sgpr31, implicit killed $vgpr0
    renamable $vgpr0 = GLOBAL_ATOMIC_ADD_RTN killed renamable $vgpr0_vgpr1, killed renamable $vgpr2, 0, 25, implicit $exec :: (load store seq_cst (s32), addrspace 1)
    S_WAIT_LOADCNT_soft 0
    GLOBAL_INV 24, implicit $exec
    S_SETPC_B64_return undef $sgpr30_sgpr31, implicit killed $vgpr0
...
